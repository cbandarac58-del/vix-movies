---
import Navbar from '../components/Navbar.astro';

const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Genres from TMDB
const genreRes = await fetch(`https://api.themoviedb.org/3/genre/movie/list?api_key=${TMDB_KEY}`);
const genreData = await genreRes.json();
const genres = genreData.genres || [
  { id: 28, name: 'Action' },
  { id: 35, name: 'Comedy' },
  { id: 18, name: 'Drama' },
  { id: 27, name: 'Horror' },
  { id: 878, name: 'Sci-Fi' },
  { id: 10749, name: 'Romance' },
  { id: 53, name: 'Thriller' },
  { id: 16, name: 'Animation' }
];

// Fetch Trending Movies
const trendRes = await fetch(`https://api.themoviedb.org/3/trending/movie/day?api_key=${TMDB_KEY}`);
const trendData = await trendRes.json();
const movies = trendData.results || [];
---

<div class="category-wrapper">
  <button class="cat-pill active" data-genre="all">All</button>
  {genres.map((g) => (
    <button class="cat-pill" data-genre={g.id}>{g.name}</button>
  ))}
</div>

<!-- Movies Grid Area -->
<div class="section-title">
  <h2 id="category-heading">🔥 Trending Today</h2>
</div>

<div id="movies-container" class="grid-movies">
  {movies.map((m) => (
    <a href={`/movie/${m.id}`} class="movie-card" data-genres={JSON.stringify(m.genre_ids)}>
      <div class="poster-box">
        <img src={m.poster_path ? `https://image.tmdb.org/t/p/w500${m.poster_path}` : 'https://via.placeholder.com/500x750'} alt={m.title} />
        <span class="badge-hd">HD</span>
        <span class="badge-rating">⭐ {m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
      </div>
      <h3 class="card-title">{m.title}</h3>
    </a>
  ))}
</div>

<style>
  .category-wrapper {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 10px 0;
    margin: 15px 0;
    scrollbar-width: none; /* Hide scrollbar Firefox */
  }
  .category-wrapper::-webkit-scrollbar {
    display: none; /* Hide scrollbar Chrome/Safari */
  }
  .cat-pill {
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .cat-pill:hover {
    background: #334155;
    color: white;
  }
  .cat-pill.active {
    background: #0284c7;
    border-color: #38bdf8;
    color: white;
    box-shadow: 0 0 10px rgba(2, 132, 199, 0.5);
  }
  .grid-movies {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 15px;
  }
  .movie-card {
    text-decoration: none;
    color: white;
  }
  .poster-box {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 2/3;
  }
  .poster-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge-hd {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #0284c7;
    font-size: 10px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .badge-rating {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(15, 23, 42, 0.8);
    font-size: 10px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .card-title {
    font-size: 13px;
    margin: 8px 0 0 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script is:inline define:vars={{ tmdbKey: TMDB_KEY }}>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.cat-pill');
    const heading = document.getElementById('category-heading');
    const container = document.getElementById('movies-container');

    pills.forEach(pill => {
      pill.addEventListener('click', async (e) => {
        // Active Button UI Highlight Update
        pills.forEach(p => p.classList.remove('active'));
        e.target.classList.add('active');

        const genreId = e.target.getAttribute('data-genre');
        const genreName = e.target.innerText;

        heading.innerText = genreId === 'all' ? '🔥 Trending Today' : `🎬 ${genreName} Movies`;

        // Local Filter / Fetching API
        if (genreId === 'all') {
          const cards = container.querySelectorAll('.movie-card');
          cards.forEach(c => c.style.display = 'block');
        } else {
          // Fetch directly from TMDB for full genre results
          container.innerHTML = '<p style="color: #94a3b8; font-size: 14px;">Loading movies...</p>';
          try {
            const res = await fetch(`https://api.themoviedb.org/3/discover/movie?api_key=${tmdbKey}&with_genres=${genreId}`);
            const data = await res.json();
            
            container.innerHTML = '';
            if (data.results && data.results.length > 0) {
              data.results.forEach(m => {
                const card = document.createElement('a');
                card.href = `/movie/${m.id}`;
                card.className = 'movie-card';
                card.innerHTML = `
                  <div class="poster-box">
                    <img src="${m.poster_path ? 'https://image.tmdb.org/t/p/w500' + m.poster_path : 'https://via.placeholder.com/500x750'}" alt="${m.title}" />
                    <span class="badge-hd">HD</span>
                    <span class="badge-rating">⭐ ${m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
                  </div>
                  <h3 class="card-title">${m.title}</h3>
                `;
                container.appendChild(card);
              });
            } else {
              container.innerHTML = '<p style="color: #94a3b8;">No movies found in this category.</p>';
            }
          } catch (err) {
            container.innerHTML = '<p style="color: #ef4444;">Failed to load movies.</p>';
          }
        }
      });
    });
  });
</script>
