---
import Navbar from '../components/Navbar.astro';

const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Genres
const genreRes = await fetch(`https://api.themoviedb.org/3/genre/movie/list?api_key=${TMDB_KEY}`);
const genreData = await genreRes.json();
const genres = genreData.genres || [];

// Fetch Trending Movies
const trendRes = await fetch(`https://api.themoviedb.org/3/trending/movie/day?api_key=${TMDB_KEY}`);
const trendData = await trendRes.json();
const movies = trendData.results || [];

// Featured Movie
const featured = movies[0] || {
  id: 1241982,
  title: 'Moana 2',
  overview: 'Teenage Moana answers the Ocean\'s call and voyages beyond the reef of her island...',
  backdrop_path: '/3V4kSt8AL9A38y3VE8A3L.jpg'
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vix Movies - Watch Free HD Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }

      /* Hero Featured Banner */
      .hero-card {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        margin: 10px 0 20px 0;
        background: #1e293b;
        border: 1px solid #334155;
      }
      .hero-bg {
        width: 100%;
        height: 260px;
        object-fit: cover;
        display: block;
        filter: brightness(0.65);
      }
      .hero-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 16px;
        background: linear-gradient(to top, rgba(11, 15, 25, 0.95), rgba(11, 15, 25, 0));
      }
      .badge-featured {
        color: #38bdf8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
      }
      .hero-title {
        font-size: 22px;
        font-weight: 800;
        margin: 2px 0 6px 0;
      }
      .hero-desc {
        color: #cbd5e1;
        font-size: 12px;
        line-height: 1.4;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .btn-watch {
        display: inline-flex;
        align-items: center;
        background: #0284c7;
        color: white;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: bold;
        font-size: 13px;
      }

      /* Category Pills Bar */
      .category-container {
        margin-bottom: 15px;
      }
      .category-wrapper {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 8px;
      }
      .cat-pill {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .cat-pill.active {
        background: #0284c7;
        border-color: #0284c7;
        color: white;
      }

      /* Fixed Grid System */
      .grid-movies {
        display: grid !important;
        grid-template-columns: repeat(2, calc(50% - 6px)) !important;
        gap: 12px !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      @media (min-width: 640px) {
        .grid-movies { grid-template-columns: repeat(3, calc(33.33% - 8px)) !important; }
      }
      @media (min-width: 900px) {
        .grid-movies { grid-template-columns: repeat(4, calc(25% - 9px)) !important; }
      }

      .movie-card {
        text-decoration: none;
        color: white;
        display: block;
        width: 100%;
        overflow: hidden;
      }
      .poster-box {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 2/3;
        background: #1e293b;
        border: 1px solid #334155;
        width: 100%;
      }
      .poster-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .badge-hd {
        position: absolute;
        top: 6px;
        left: 6px;
        background: #0284c7;
        font-size: 9px;
        font-weight: bold;
        padding: 2px 5px;
        border-radius: 4px;
      }
      .badge-rating {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(15, 23, 42, 0.85);
        font-size: 9px;
        font-weight: bold;
        padding: 2px 5px;
        border-radius: 4px;
      }
      .card-title {
        font-size: 12px;
        margin: 6px 0 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar activePage="home" />

      <!-- Hero Banner -->
      <div class="hero-card">
        <img class="hero-bg" src={`https://image.tmdb.org/t/p/w1280${featured.backdrop_path || featured.poster_path}`} alt={featured.title} />
        <div class="hero-overlay">
          <span class="badge-featured">FEATURED #1 TRENDING</span>
          <h1 class="hero-title">{featured.title}</h1>
          <p class="hero-desc">{featured.overview}</p>
          <a href={`/movie/${featured.id}`} class="btn-watch">► Watch Now</a>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="category-container">
        <div class="category-wrapper">
          <button class="cat-pill active" data-genre="all">🔥 All</button>
          {genres.map((g) => (
            <button class="cat-pill" data-genre={g.id}>{g.name}</button>
          ))}
        </div>
      </div>

      <div style="margin-bottom: 12px;">
        <h2 id="category-heading" style="font-size: 16px; font-weight: 800; margin: 0;">🔥 Trending Today</h2>
      </div>

      <!-- Movie Grid -->
      <div id="movies-container" class="grid-movies">
        {movies.map((m) => (
          <a href={`/movie/${m.id}`} class="movie-card">
            <div class="poster-box">
              <img src={m.poster_path ? `https://image.tmdb.org/t/p/w500${m.poster_path}` : 'https://via.placeholder.com/500x750'} alt={m.title} loading="lazy" />
              <span class="badge-hd">HD</span>
              <span class="badge-rating">⭐ {m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
            </div>
            <h3 class="card-title">{m.title}</h3>
          </a>
        ))}
      </div>
    </div>

    <script is:inline define:vars={{ tmdbKey: TMDB_KEY }}>
      document.addEventListener('DOMContentLoaded', () => {
        const pills = document.querySelectorAll('.cat-pill');
        const heading = document.getElementById('category-heading');
        const container = document.getElementById('movies-container');

        pills.forEach(pill => {
          pill.addEventListener('click', async (e) => {
            pills.forEach(p => p.classList.remove('active'));
            e.target.classList.add('active');

            const genreId = e.target.getAttribute('data-genre');
            const genreName = e.target.innerText;

            heading.innerText = genreId === 'all' ? '🔥 Trending Today' : `🎬 ${genreName} Movies`;
            container.innerHTML = '<p style="color: #94a3b8; font-size: 14px; grid-column: 1 / -1;">Loading movies...</p>';
            
            try {
              const url = genreId === 'all' 
                ? `https://api.themoviedb.org/3/trending/movie/day?api_key=${tmdbKey}`
                : `https://api.themoviedb.org/3/discover/movie?api_key=${tmdbKey}&with_genres=${genreId}`;

              const res = await fetch(url);
              const data = await res.json();
              
              container.innerHTML = '';
              if (data.results && data.results.length > 0) {
                data.results.forEach(m => {
                  const card = document.createElement('a');
                  card.href = `/movie/${m.id}`;
                  card.className = 'movie-card';
                  card.innerHTML = `
                    <div class="poster-box">
                      <img src="${m.poster_path ? 'https://image.tmdb.org/t/p/w500' + m.poster_path : 'https://via.placeholder.com/500x750'}" alt="${m.title}" loading="lazy" />
                      <span class="badge-hd">HD</span>
                      <span class="badge-rating">⭐ ${m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
                    </div>
                    <h3 class="card-title">${m.title}</h3>
                  `;
                  container.appendChild(card);
                });
              } else {
                container.innerHTML = '<p style="color: #94a3b8; grid-column: 1 / -1;">No movies found.</p>';
              }
            } catch (err) {
              container.innerHTML = '<p style="color: #ef4444; grid-column: 1 / -1;">Failed to load movies.</p>';
            }
          });
        });
      });
    </script>
  </body>
</html>
