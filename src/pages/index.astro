---
import Navbar from '../components/Navbar.astro';

const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Genres
const genreRes = await fetch(`https://api.themoviedb.org/3/genre/movie/list?api_key=${TMDB_KEY}`);
const genreData = await genreRes.json();
const genres = genreData.genres || [];

// Fetch Trending Movies
const trendRes = await fetch(`https://api.themoviedb.org/3/trending/movie/day?api_key=${TMDB_KEY}`);
const trendData = await trendRes.json();
const movies = trendData.results || [];

// Featured Movie
const featured = movies[0] || {
  id: 1241982,
  title: 'Moana 2',
  overview: 'Teenage Moana answers the Ocean\'s call and voyages beyond the reef of her island...',
  backdrop_path: '/3V4kSt8AL9A38y3VE8A3L.jpg'
};

// Website Canonical & Base URL Configuration
const SITE_URL = 'https://vixmovies.com'; // Change to your custom domain or Cloudflare Pages URL

// Schema.org Structured Data (SEO, AEO & GEO Engine Optimization)
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      "url": SITE_URL,
      "name": "Vix Movies",
      "description": "Watch high-definition movies, trending TV series, and cinema releases online for free.",
      "publisher": {
        "@type": "Organization",
        "name": "Vix Movies",
        "url": SITE_URL
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE_URL}/search?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "ItemList",
      "name": "Trending Movies Today",
      "itemListElement": movies.slice(0, 10).map((m, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Movie",
          "name": m.title,
          "url": `${SITE_URL}/movie/${m.id}`,
          "image": m.poster_path ? `https://image.tmdb.org/t/p/w500${m.poster_path}` : ''
        }
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Vix Movies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vix Movies is a free online streaming platform providing access to trending HD movies, TV shows, Hollywood, and global release information."
          }
        },
        {
          "@type": "Question",
          "name": "Is Vix Movies free to watch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Vix Movies allows user access to trending movie details, trailers, and streaming options without subscription fees."
          }
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags (SEO) -->
    <title>Vix Movies - Watch Free HD Movies & TV Series Online</title>
    <meta name="title" content="Vix Movies - Watch Free HD Movies & TV Series Online" />
    <meta name="description" content="Watch high-definition movies, trending TV series, Hollywood, and global cinema releases online for free on Vix Movies. Stream trending titles in 1080p." />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Vix Movies" />
    <link rel="canonical" href={SITE_URL} />

    <!-- Open Graph / Facebook / WhatsApp (Social SEO) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content="Vix Movies - Watch Free HD Movies & TV Series Online" />
    <meta property="og:description" content="Stream high-definition movies and trending TV shows for free on Vix Movies." />
    <meta property="og:image" content={`https://image.tmdb.org/t/p/w1280${featured.backdrop_path || featured.poster_path}`} />

    <!-- Twitter / X Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={SITE_URL} />
    <meta name="twitter:title" content="Vix Movies - Watch Free HD Movies & TV Series Online" />
    <meta name="twitter:description" content="Stream high-definition movies and trending TV shows for free on Vix Movies." />
    <meta name="twitter:image" content={`https://image.tmdb.org/t/p/w1280${featured.backdrop_path || featured.poster_path}`} />

    <!-- Structured Data (JSON-LD for Google, Perplexity & AI Search Crawlers) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <style is:global>
      * {
        box-sizing: border-box;
      }
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 12px 40px 12px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }

      /* Hero Featured Banner */
      .hero-card {
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        margin: 10px 0 20px 0;
        background: #1e293b;
        border: 1px solid #334155;
      }
      .hero-bg {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
        filter: brightness(0.65);
      }
      .hero-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 14px;
        background: linear-gradient(to top, rgba(11, 15, 25, 0.95), rgba(11, 15, 25, 0));
      }
      .badge-featured {
        color: #38bdf8;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
      }
      .hero-title {
        font-size: 20px;
        font-weight: 800;
        margin: 2px 0 6px 0;
      }
      .hero-desc {
        color: #cbd5e1;
        font-size: 11px;
        line-height: 1.4;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .btn-watch {
        display: inline-flex;
        align-items: center;
        background: #0284c7;
        color: white;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: bold;
        font-size: 12px;
      }

      /* Category Pills Bar */
      .category-container {
        margin-bottom: 15px;
        width: 100%;
        overflow: hidden;
      }
      .category-wrapper {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 8px;
        -webkit-overflow-scrolling: touch;
      }
      .cat-pill {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .cat-pill.active {
        background: #0284c7;
        border-color: #0284c7;
        color: white;
      }

      /* Grid Layout */
      .grid-movies {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 10px !important;
        width: 100% !important;
      }
      @media (min-width: 640px) {
        .grid-movies {
          grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
          gap: 14px !important;
        }
      }
      @media (min-width: 900px) {
        .grid-movies {
          grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
          gap: 16px !important;
        }
      }

      .movie-card {
        text-decoration: none;
        color: white;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
        overflow: hidden;
      }
      .poster-box {
        position: relative;
        width: 100%;
        border-radius: 8px;
        overflow: hidden;
        aspect-ratio: 2 / 3;
        background: #1e293b;
        border: 1px solid #334155;
      }
      .poster-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .badge-hd {
        position: absolute;
        top: 6px;
        left: 6px;
        background: #0284c7;
        font-size: 9px;
        font-weight: bold;
        padding: 2px 5px;
        border-radius: 4px;
        z-index: 2;
      }
      .badge-rating {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(15, 23, 42, 0.85);
        font-size: 9px;
        font-weight: bold;
        padding: 2px 5px;
        border-radius: 4px;
        z-index: 2;
      }
      .card-title {
        font-size: 12px;
        font-weight: 600;
        margin: 6px 0 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
      }

      /* AEO / GEO Content Section */
      .aeo-section {
        margin-top: 40px;
        padding: 20px;
        background: #1e293b;
        border-radius: 12px;
        border: 1px solid #334155;
      }
      .aeo-section h2 {
        font-size: 16px;
        color: #38bdf8;
        margin-top: 0;
      }
      .aeo-section p, .aeo-section li {
        font-size: 13px;
        color: #cbd5e1;
        line-height: 1.6;
      }

      /* Footer Styles */
      .site-footer {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #334155;
        text-align: center;
      }
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 12px;
      }
      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
      }
      .footer-links a:hover {
        color: #38bdf8;
      }
      .copyright-text {
        color: #64748b;
        font-size: 12px;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar activePage="home" />

      <!-- Main Semantic Hero Section -->
      <main>
        <article class="hero-card">
          <img class="hero-bg" src={`https://image.tmdb.org/t/p/w1280${featured.backdrop_path || featured.poster_path}`} alt={`Watch ${featured.title} on Vix Movies`} />
          <div class="hero-overlay">
            <span class="badge-featured">FEATURED #1 TRENDING</span>
            <h1 class="hero-title">{featured.title}</h1>
            <p class="hero-desc">{featured.overview}</p>
            <a href={`/movie/${featured.id}`} class="btn-watch" aria-label={`Watch ${featured.title} now`}>► Watch Now</a>
          </div>
        </article>

        <!-- Category Filter Pills -->
        <nav class="category-container" aria-label="Movie Genre Filters">
          <div class="category-wrapper">
            <button class="cat-pill active" data-genre="all">🔥 All</button>
            {genres.map((g) => (
              <button class="cat-pill" data-genre={g.id}>{g.name}</button>
            ))}
          </div>
        </nav>

        <div style="margin-bottom: 12px;">
          <h2 id="category-heading" style="font-size: 16px; font-weight: 800; margin: 0;">🔥 Trending Today</h2>
        </div>

        <!-- Movie Grid -->
        <section id="movies-container" class="grid-movies" aria-label="Trending Movies List">
          {movies.map((m) => (
            <a href={`/movie/${m.id}`} class="movie-card" title={`Watch ${m.title} online`}>
              <div class="poster-box">
                <img src={m.poster_path ? `https://image.tmdb.org/t/p/w500${m.poster_path}` : 'https://via.placeholder.com/500x750'} alt={`${m.title} Poster`} loading="lazy" width="500" height="750" />
                <span class="badge-hd">HD</span>
                <span class="badge-rating">⭐ {m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
              </div>
              <h3 class="card-title">{m.title}</h3>
            </a>
          ))}
        </section>

        <!-- AEO & GEO Direct Information Box (Helps Perplexity, ChatGPT & Gemini Indexing) -->
        <section class="aeo-section">
          <h2>About Vix Movies Free Streaming</h2>
          <p><strong>Vix Movies</strong> is an online movie database and streaming discovery platform designed to provide high-quality stream links, release information, and ratings for global movies and TV series.</p>
          <h3>Frequently Asked Questions</h3>
          <ul>
            <li><strong>Is Vix Movies free?</strong> Yes, you can browse and watch trending content without hidden subscription fees.</li>
            <li><strong>How often is content updated?</strong> Daily trending lists are automatically updated via real-time TMDB API integration.</li>
          </ul>
        </section>
      </main>

      <!-- SEO Footer Structure -->
      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
      </footer>
    </div>

    <script is:inline define:vars={{ tmdbKey: TMDB_KEY }}>
      document.addEventListener('DOMContentLoaded', () => {
        const pills = document.querySelectorAll('.cat-pill');
        const heading = document.getElementById('category-heading');
        const container = document.getElementById('movies-container');

        pills.forEach(pill => {
          pill.addEventListener('click', async (e) => {
            pills.forEach(p => p.classList.remove('active'));
            e.target.classList.add('active');

            const genreId = e.target.getAttribute('data-genre');
            const genreName = e.target.innerText;

            heading.innerText = genreId === 'all' ? '🔥 Trending Today' : `🎬 ${genreName} Movies`;
            container.innerHTML = '<p style="color: #94a3b8; font-size: 14px; grid-column: 1 / -1; padding: 20px 0;">Loading movies...</p>';
            
            try {
              const url = genreId === 'all' 
                ? `https://api.themoviedb.org/3/trending/movie/day?api_key=${tmdbKey}`
                : `https://api.themoviedb.org/3/discover/movie?api_key=${tmdbKey}&with_genres=${genreId}`;

              const res = await fetch(url);
              const data = await res.json();
              
              container.innerHTML = '';
              if (data.results && data.results.length > 0) {
                data.results.forEach(m => {
                  const card = document.createElement('a');
                  card.href = `/movie/${m.id}`;
                  card.className = 'movie-card';
                  card.title = `Watch ${m.title} online`;
                  card.innerHTML = `
                    <div class="poster-box">
                      <img src="${m.poster_path ? 'https://image.tmdb.org/t/p/w500' + m.poster_path : 'https://via.placeholder.com/500x750'}" alt="${m.title} Poster" loading="lazy" width="500" height="750" />
                      <span class="badge-hd">HD</span>
                      <span class="badge-rating">⭐ ${m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
                    </div>
                    <h3 class="card-title">${m.title}</h3>
                  `;
                  container.appendChild(card);
                });
              } else {
                container.innerHTML = '<p style="color: #94a3b8; grid-column: 1 / -1; padding: 20px 0;">No movies found.</p>';
              }
            } catch (err) {
              container.innerHTML = '<p style="color: #ef4444; grid-column: 1 / -1; padding: 20px 0;">Failed to load movies.</p>';
            }
          });
        });
      });
    </script>
  </body>
</html>
