---
import Navbar from '../components/Navbar.astro';

const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Genres
const genreRes = await fetch(`https://api.themoviedb.org/3/genre/movie/list?api_key=${TMDB_KEY}`);
const genreData = await genreRes.json();
const genres = genreData.genres || [
  { id: 28, name: 'Action' },
  { id: 35, name: 'Comedy' },
  { id: 18, name: 'Drama' },
  { id: 27, name: 'Horror' },
  { id: 878, name: 'Sci-Fi' },
  { id: 10749, name: 'Romance' }
];

// Fetch Trending Movies
const trendRes = await fetch(`https://api.themoviedb.org/3/trending/movie/day?api_key=${TMDB_KEY}`);
const trendData = await trendRes.json();
const movies = trendData.results || [];

// Featured Movie (First trending movie or fallback to Moana)
const featured = movies[0] || {
  id: 1241982,
  title: 'Moana 2',
  overview: 'Teenage Moana answers the Ocean\'s call and voyages beyond the reef of her island...',
  backdrop_path: '/3V4kSt8AL9A38y3VE8A3L.jpg'
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vix Movies - Watch Free HD Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }

      /* Search Bar Styling */
      .search-bar {
        display: flex;
        gap: 8px;
        margin: 15px 0 20px 0;
      }
      .search-input {
        flex: 1;
        background: #1e293b;
        border: 1px solid #334155;
        color: white;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
      }
      .search-btn {
        background: #0284c7;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
      }

      /* Hero Featured Banner */
      .hero-card {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 25px;
        background: #1e293b;
        border: 1px solid #334155;
      }
      .hero-bg {
        width: 100%;
        height: 320px;
        object-fit: cover;
        display: block;
        filter: brightness(0.7);
      }
      .hero-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 20px;
        background: linear-gradient(to top, rgba(11, 15, 25, 0.95), rgba(11, 15, 25, 0));
      }
      .badge-featured {
        color: #38bdf8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
      }
      .hero-title {
        font-size: 26px;
        font-weight: 800;
        margin: 4px 0 8px 0;
      }
      .hero-desc {
        color: #cbd5e1;
        font-size: 13px;
        line-height: 1.4;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .btn-watch {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #0284c7;
        color: white;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
        font-size: 14px;
      }

      /* Category Pills Bar with Visual Indicator */
      .category-container {
        position: relative;
        margin-bottom: 20px;
      }
      .category-wrapper {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 8px;
        scrollbar-width: thin;
        scrollbar-color: #334155 transparent;
      }
      .category-wrapper::-webkit-scrollbar {
        height: 3px;
      }
      .category-wrapper::-webkit-scrollbar-thumb {
        background: #38bdf8;
        border-radius: 4px;
      }
      .category-wrapper::-webkit-scrollbar-track {
        background: #1e293b;
      }
      .cat-pill {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .cat-pill.active {
        background: #0284c7;
        border-color: #0284c7;
        color: white;
      }

      /* 2-Column Responsive Movie Grid */
      .grid-movies {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }
      @media (min-width: 640px) {
        .grid-movies { grid-template-columns: repeat(3, 1fr); }
      }
      @media (min-width: 900px) {
        .grid-movies { grid-template-columns: repeat(4, 1fr); }
      }

      .movie-card {
        text-decoration: none;
        color: white;
      }
      .poster-box {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 2/3;
        background: #1e293b;
        border: 1px solid #334155;
      }
      .poster-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .badge-hd {
        position: absolute;
        top: 6px;
        left: 6px;
        background: #0284c7;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .badge-rating {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(15, 23, 42, 0.8);
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .card-title {
        font-size: 13px;
        margin: 6px 0 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar activePage="home" />

      <!-- Search Bar -->
      <form action="/search" method="GET" class="search-bar">
        <input type="text" name="q" class="search-input" placeholder="Search movies, TV shows..." required />
        <button type="submit" class="search-btn">Search</button>
      </form>

      <!-- Featured Banner -->
      <div class="hero-card">
        <img class="hero-bg" src={`https://image.tmdb.org/t/p/w1280${featured.backdrop_path || featured.poster_path}`} alt={featured.title} />
        <div class="hero-overlay">
          <span class="badge-featured">FEATURED #1 TRENDING</span>
          <h1 class="hero-title">{featured.title}</h1>
          <p class="hero-desc">{featured.overview}</p>
          <a href={`/movie/${featured.id}`} class="btn-watch">► Watch Now</a>
        </div>
      </div>

      <!-- Categories with Horizontal Indicator -->
      <div class="category-container">
        <div class="category-wrapper">
          <button class="cat-pill active" data-genre="all">Action</button>
          <button class="cat-pill" data-genre="35">Comedy</button>
          <button class="cat-pill" data-genre="18">Drama</button>
          <button class="cat-pill" data-genre="27">Horror</button>
          {genres.map((g) => (
            <button class="cat-pill" data-genre={g.id}>{g.name}</button>
          ))}
        </div>
      </div>

      <!-- Heading -->
      <div style="margin-bottom: 12px;">
        <h2 id="category-heading" style="font-size: 18px; font-weight: 800; margin: 0;">🔥 Trending Today</h2>
      </div>

      <!-- Movie List -->
      <div id="movies-container" class="grid-movies">
        {movies.map((m) => (
          <a href={`/movie/${m.id}`} class="movie-card">
            <div class="poster-box">
              <img src={m.poster_path ? `https://image.tmdb.org/t/p/w500${m.poster_path}` : 'https://via.placeholder.com/500x750'} alt={m.title} loading="lazy" />
              <span class="badge-hd">HD</span>
              <span class="badge-rating">⭐ {m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
            </div>
            <h3 class="card-title">{m.title}</h3>
          </a>
        ))}
      </div>
    </div>

    <script is:inline define:vars={{ tmdbKey: TMDB_KEY }}>
      document.addEventListener('DOMContentLoaded', () => {
        const pills = document.querySelectorAll('.cat-pill');
        const heading = document.getElementById('category-heading');
        const container = document.getElementById('movies-container');

        pills.forEach(pill => {
          pill.addEventListener('click', async (e) => {
            pills.forEach(p => p.classList.remove('active'));
            e.target.classList.add('active');

            const genreId = e.target.getAttribute('data-genre');
            const genreName = e.target.innerText;

            heading.innerText = genreId === 'all' ? '🔥 Trending Today' : `🎬 ${genreName} Movies`;

            container.innerHTML = '<p style="color: #94a3b8; font-size: 14px; grid-column: 1 / -1;">Loading movies...</p>';
            
            try {
              const url = genreId === 'all' 
                ? `https://api.themoviedb.org/3/trending/movie/day?api_key=${tmdbKey}`
                : `https://api.themoviedb.org/3/discover/movie?api_key=${tmdbKey}&with_genres=${genreId}`;

              const res = await fetch(url);
              const data = await res.json();
              
              container.innerHTML = '';
              if (data.results && data.results.length > 0) {
                data.results.forEach(m => {
                  const card = document.createElement('a');
                  card.href = `/movie/${m.id}`;
                  card.className = 'movie-card';
                  card.innerHTML = `
                    <div class="poster-box">
                      <img src="${m.poster_path ? 'https://image.tmdb.org/t/p/w500' + m.poster_path : 'https://via.placeholder.com/500x750'}" alt="${m.title}" loading="lazy" />
                      <span class="badge-hd">HD</span>
                      <span class="badge-rating">⭐ ${m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
                    </div>
                    <h3 class="card-title">${m.title}</h3>
                  `;
                  container.appendChild(card);
                });
              } else {
                container.innerHTML = '<p style="color: #94a3b8; grid-column: 1 / -1;">No movies found in this category.</p>';
              }
            } catch (err) {
              container.innerHTML = '<p style="color: #ef4444; grid-column: 1 / -1;">Failed to load movies.</p>';
            }
          });
        });
      });
    </script>
  </body>
</html>
