---
import Navbar from '../../components/Navbar.astro';

const { id } = Astro.params;
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Movie Details
const res = await fetch(`https://api.themoviedb.org/3/movie/${id}?api_key=${TMDB_KEY}`);
const movie = await res.json();

// Fetch Similar Movies
const simRes = await fetch(`https://api.themoviedb.org/3/movie/${id}/similar?api_key=${TMDB_KEY}`);
const simData = await simRes.json();
const similarMovies = (simData.results || []).slice(0, 6);

// Configuration & SEO Variables
const SITE_URL = 'https://vixmovies.com';
const movieTitle = movie.title || 'Movie Details';
const releaseYear = movie.release_date ? movie.release_date.split('-')[0] : '';
const pageTitle = `Watch ${movieTitle} (${releaseYear}) Free HD Online - Vix Movies`;
const pageDescription = `Stream ${movieTitle} (${releaseYear}) full movie online in HD for free. ${movie.overview ? movie.overview.slice(0, 150) + '...' : 'Watch trending movies and TV series on Vix Movies.'}`;
const posterUrl = movie.poster_path ? `https://image.tmdb.org/t/p/w500${movie.poster_path}` : 'https://via.placeholder.com/500x750';
const backdropUrl = movie.backdrop_path ? `https://image.tmdb.org/t/p/w1280${movie.backdrop_path}` : posterUrl;
const pageUrl = `${SITE_URL}/movie/${id}`;

// Schema.org Structured Data (SEO, AEO & GEO Strategy)
const movieSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Movie",
      "@id": pageUrl,
      "url": pageUrl,
      "name": movieTitle,
      "image": posterUrl,
      "description": movie.overview || pageDescription,
      "datePublished": movie.release_date || releaseYear,
      "duration": movie.runtime ? `PT${movie.runtime}M` : undefined,
      "aggregateRating": movie.vote_average ? {
        "@type": "AggregateRating",
        "ratingValue": movie.vote_average.toFixed(1),
        "bestRating": "10",
        "worstRating": "1",
        "ratingCount": movie.vote_count || 100
      } : undefined,
      "genre": movie.genres ? movie.genres.map((g: any) => g.name) : []
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": SITE_URL
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Movies",
          "item": `${SITE_URL}/#movies`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": movieTitle,
          "item": pageUrl
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Dynamic Primary Meta Tags (SEO) -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Vix Movies" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Facebook / WhatsApp (Social Media Optimization) -->
    <meta property="og:type" content="video.movie" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={backdropUrl} />

    <!-- Twitter / X Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={backdropUrl} />

    <!-- Structured Data (JSON-LD for Google, Perplexity & AI Search Crawlers) -->
    <script type="application/ld+json" set:html={JSON.stringify(movieSchema)} />

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .movie-header {
        margin-top: 15px;
        margin-bottom: 15px;
      }
      .movie-title {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 5px 0;
      }
      .movie-meta {
        color: #94a3b8;
        font-size: 14px;
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
      }
      .server-bar {
        background: #1e293b;
        padding: 12px;
        border-radius: 8px;
        margin: 15px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border: 1px solid #334155;
      }
      .server-btn {
        background: #0f172a;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.2s;
      }
      .server-btn.active {
        background: #0284c7;
        color: white;
        border-color: #0284c7;
      }
      .player-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #334155;
        background: #000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .player-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Action Bar (Like & Share) */
      .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #1e293b;
        padding: 12px 16px;
        border-radius: 8px;
        margin-top: 15px;
        border: 1px solid #334155;
        flex-wrap: wrap;
        gap: 12px;
      }
      .vote-container, .share-container {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .share-title {
        font-size: 13px;
        color: #94a3b8;
        font-weight: 600;
      }
      .vote-btn {
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid #334155;
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s;
      }
      .vote-btn:hover {
        background: #334155;
      }
      .vote-btn.active-like {
        background: #22c55e;
        border-color: #22c55e;
        color: white;
      }
      .vote-btn.active-dislike {
        background: #ef4444;
        border-color: #ef4444;
        color: white;
      }
      .share-btn {
        border: none;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.2s;
      }
      .share-btn:hover {
        opacity: 0.85;
      }
      .share-btn.wa { background: #25D366; }
      .share-btn.fb { background: #1877F2; }
      .share-btn.tg { background: #229ED9; }
      .share-btn.copy { background: #475569; }

      /* AEO / GEO Dynamic Movie Information Block */
      .movie-info-block {
        margin-top: 25px;
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #334155;
      }
      .movie-info-block h2 {
        font-size: 18px;
        color: #38bdf8;
        margin-top: 0;
      }
      .movie-info-block p {
        color: #cbd5e1;
        line-height: 1.6;
        font-size: 14px;
      }

      /* Comment System Styling */
      .comments-section {
        margin-top: 35px;
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #334155;
      }
      .comment-input-box {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 20px;
      }
      .comment-input, .comment-textarea {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
      }
      .comment-textarea {
        resize: vertical;
        min-height: 70px;
      }
      .comment-btn {
        align-self: flex-start;
        background: #0284c7;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .comment-btn:hover {
        background: #0369a1;
      }
      .comment-card {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 10px;
      }
      .comment-author {
        font-weight: bold;
        color: #38bdf8;
        font-size: 13px;
      }
      .comment-date {
        font-size: 11px;
        color: #64748b;
        margin-left: 8px;
      }
      .comment-text {
        font-size: 14px;
        color: #cbd5e1;
        margin-top: 6px;
        line-height: 1.4;
      }
      .load-more-btn {
        width: 100%;
        background: #334155;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 10px;
      }

      .grid-recommendations {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 15px;
      }
      .rec-card {
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #334155;
        text-decoration: none;
        color: white;
        transition: transform 0.2s;
      }
      .rec-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
      }

      /* Site Footer */
      .site-footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #334155;
        text-align: center;
      }
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 12px;
      }
      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
      }
      .footer-links a:hover {
        color: #38bdf8;
      }
      .copyright-text {
        color: #64748b;
        font-size: 12px;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <main>
        <!-- Header Title Section -->
        <header class="movie-header">
          <h1 class="movie-title">{movieTitle} {releaseYear ? `(${releaseYear})` : ''}</h1>
          <div class="movie-meta">
            <span>⭐ {movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'} / 10 Rating</span>
            <span>⏱️ {movie.runtime ? `${movie.runtime} mins` : 'N/A'}</span>
            <span style="color: #38bdf8; font-weight: bold;">HD Quality</span>
            {movie.genres && (
              <span>🎭 {movie.genres.map((g: any) => g.name).join(', ')}</span>
            )}
          </div>
        </header>

        <!-- Server Switcher Bar -->
        <nav class="server-bar" aria-label="Streaming Server Selection">
          <span style="font-size: 14px; font-weight: 600; color: #94a3b8;">Select Server:</span>
          <button class="server-btn active" data-server="autoembed">Server 1 (AutoEmbed)</button>
          <button class="server-btn" data-server="vidsrc">Server 2 (VidSrc)</button>
          <button class="server-btn" data-server="smashy">Server 3 (SmashyStream)</button>
        </nav>

        <!-- Video Player Frame -->
        <section class="player-container" aria-label="Movie Player">
          <iframe 
            id="movie-player"
            class="player-iframe"
            src={`https://autoembed.co/movie/tmdb/${id}`} 
            title={`Watch ${movieTitle}`}
            allowfullscreen>
          </iframe>
        </section>

        <!-- Action Bar (Like & Share) -->
        <div class="action-bar">
          <div class="vote-container">
            <button id="like-btn" class="vote-btn" aria-label="Like movie">
              👍 <span id="like-count">0</span>
            </button>
            <button id="dislike-btn" class="vote-btn" aria-label="Dislike movie">
              👎 <span id="dislike-count">0</span>
            </button>
          </div>

          <div class="share-container">
            <span class="share-title">Share:</span>
            <button id="share-wa" class="share-btn wa">WhatsApp</button>
            <button id="share-fb" class="share-btn fb">Facebook</button>
            <button id="share-tg" class="share-btn tg">Telegram</button>
            <button id="copy-link" class="share-btn copy">📋 Copy Link</button>
          </div>
        </div>

        <!-- Semantic Overview & AEO/GEO Box -->
        <article class="movie-info-block">
          <h2>Storyline & Overview</h2>
          <p>{movie.overview || 'No storyline overview available for this title.'}</p>
        </article>

        <!-- Native Comment Section -->
        <section class="comments-section" aria-label="User Reviews and Comments">
          <h2 style="font-size: 18px; margin-top: 0; margin-bottom: 15px;">💬 User Comments & Reviews</h2>
          
          <div class="comment-input-box">
            <input type="text" id="user-name" placeholder="Your Name..." class="comment-input" />
            <textarea id="user-comment" placeholder="Write your review or comment..." class="comment-textarea"></textarea>
            <button id="post-btn" class="comment-btn">Post Comment</button>
          </div>

          <div id="comments-list"></div>
          <button id="load-more-btn" class="load-more-btn" style="display: none;">View More Comments</button>
        </section>

        <!-- Similar Movies Recommendations -->
        {similarMovies.length > 0 && (
          <section style="margin-top: 35px;" aria-label="Recommended Movies">
            <h2 style="font-size: 18px; margin-bottom: 15px;">You May Also Like</h2>
            <div class="grid-recommendations">
              {similarMovies.map((sim) => (
                <a href={`/movie/${sim.id}`} class="rec-card" title={`Watch ${sim.title}`}>
                  <img src={sim.poster_path ? `https://image.tmdb.org/t/p/w500${sim.poster_path}` : 'https://via.placeholder.com/500x750'} alt={`${sim.title} Poster`} style="width: 100%; aspect-ratio: 2/3; object-fit: cover; display: block;" loading="lazy" decoding="async" width="500" height="750" />
                  <div style="padding: 8px;">
                    <h3 style="font-size: 12px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{sim.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </main>

      <!-- Footer Structure -->
      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
      </footer>
    </div>

    <script is:inline define:vars={{ tmdbId: id, movieTitle: movieTitle }}>
      document.addEventListener('DOMContentLoaded', () => {
        // Server Switcher Listener
        const serverButtons = document.querySelectorAll('.server-btn');
        const player = document.getElementById('movie-player');

        serverButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            serverButtons.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            
            const server = e.target.getAttribute('data-server');
            if (server === 'vidsrc') {
              player.src = `https://vidsrc.me/embed/movie?tmdb=${tmdbId}`;
            } else if (server === 'smashy') {
              player.src = `https://embed.smashystream.com/playere.php?tmdb=${tmdbId}`;
            } else {
              player.src = `https://autoembed.co/movie/tmdb/${tmdbId}`;
            }
          });
        });

        // Like / Dislike Logic
        const likeKey = `vix_like_movie_${tmdbId}`;
        const dislikeKey = `vix_dislike_movie_${tmdbId}`;
        const userVoteKey = `vix_uservote_movie_${tmdbId}`;

        const likeBtn = document.getElementById('like-btn');
        const dislikeBtn = document.getElementById('dislike-btn');
        const likeCountEl = document.getElementById('like-count');
        const dislikeCountEl = document.getElementById('dislike-count');

        let likes = parseInt(localStorage.getItem(likeKey) || '15');
        let dislikes = parseInt(localStorage.getItem(dislikeKey) || '1');
        let userVote = localStorage.getItem(userVoteKey);

        function renderVotes() {
          likeCountEl.innerText = likes;
          dislikeCountEl.innerText = dislikes;

          likeBtn.classList.remove('active-like');
          dislikeBtn.classList.remove('active-dislike');

          if (userVote === 'like') likeBtn.classList.add('active-like');
          if (userVote === 'dislike') dislikeBtn.classList.add('active-dislike');
        }

        likeBtn.addEventListener('click', () => {
          if (userVote === 'like') {
            likes--;
            userVote = null;
          } else {
            if (userVote === 'dislike') dislikes--;
            likes++;
            userVote = 'like';
          }
          localStorage.setItem(likeKey, likes);
          localStorage.setItem(dislikeKey, dislikes);
          if (userVote) localStorage.setItem(userVoteKey, userVote);
          else localStorage.removeItem(userVoteKey);
          renderVotes();
        });

        dislikeBtn.addEventListener('click', () => {
          if (userVote === 'dislike') {
            dislikes--;
            userVote = null;
          } else {
            if (userVote === 'like') likes--;
            dislikes++;
            userVote = 'dislike';
          }
          localStorage.setItem(likeKey, likes);
          localStorage.setItem(dislikeKey, dislikes);
          if (userVote) localStorage.setItem(userVoteKey, userVote);
          else localStorage.removeItem(userVoteKey);
          renderVotes();
        });

        renderVotes();

        // Share Buttons Logic
        const currentUrl = encodeURIComponent(window.location.href);
        const shareText = encodeURIComponent(`Watch "${movieTitle || 'Movie'}" for free in HD on Vix Movies!`);

        document.getElementById('share-wa').addEventListener('click', () => {
          window.open(`https://api.whatsapp.com/send?text=${shareText}%20${currentUrl}`, '_blank');
        });

        document.getElementById('share-fb').addEventListener('click', () => {
          window.open(`https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`, '_blank');
        });

        document.getElementById('share-tg').addEventListener('click', () => {
          window.open(`https://t.me/share/url?url=${currentUrl}&text=${shareText}`, '_blank');
        });

        document.getElementById('copy-link').addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard!');
        });

        // Comment System Logic
        const storageKey = 'vix_comments_movie_' + tmdbId;
        let allComments = JSON.parse(localStorage.getItem(storageKey) || '[]');
        let showingAll = false;

        const listDiv = document.getElementById('comments-list');
        const loadBtn = document.getElementById('load-more-btn');
        const postBtn = document.getElementById('post-btn');

        function renderComments() {
          listDiv.innerHTML = '';

          if (allComments.length === 0) {
            listDiv.innerHTML = '<p style="color: #64748b; font-size: 13px;">No comments yet. Be the first to comment!</p>';
            loadBtn.style.display = 'none';
            return;
          }

          const visibleComments = showingAll ? allComments : allComments.slice(0, 5);

          visibleComments.forEach(c => {
            const card = document.createElement('div');
            card.className = 'comment-card';
            card.innerHTML = `
              <div>
                <span class="comment-author">${escapeHtml(c.name)}</span>
                <span class="comment-date">${c.date}</span>
              </div>
              <div class="comment-text">${escapeHtml(c.text)}</div>
            `;
            listDiv.appendChild(card);
          });

          if (allComments.length > 5 && !showingAll) {
            loadBtn.style.display = 'block';
            loadBtn.innerText = `View More Comments (${allComments.length - 5} remaining)`;
          } else {
            loadBtn.style.display = 'none';
          }
        }

        postBtn.addEventListener('click', () => {
          const nameInput = document.getElementById('user-name');
          const commentInput = document.getElementById('user-comment');

          const name = nameInput.value.trim() || 'Anonymous User';
          const text = commentInput.value.trim();

          if (!text) {
            alert('Please enter a comment before posting.');
            return;
          }

          const newComment = {
            name: name,
            text: text,
            date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
          };

          allComments.unshift(newComment);
          localStorage.setItem(storageKey, JSON.stringify(allComments));

          commentInput.value = '';
          renderComments();
        });

        loadBtn.addEventListener('click', () => {
          showingAll = true;
          renderComments();
        });

        function escapeHtml(text) {
          return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        renderComments();
      });
    </script>
  </body>
</html>
