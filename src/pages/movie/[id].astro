---
import Navbar from '../../components/Navbar.astro';

const { id } = Astro.params;
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Movie Details
const res = await fetch(`https://api.themoviedb.org/3/movie/${id}?api_key=${TMDB_KEY}`);
const movie = await res.json();

// Fetch Similar Movies
const simRes = await fetch(`https://api.themoviedb.org/3/movie/${id}/similar?api_key=${TMDB_KEY}`);
const simData = await simRes.json();
const similarMovies = (simData.results || []).slice(0, 6);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Watch {movie.title || 'Movie'} Free HD - Vix Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .movie-header {
        margin-top: 15px;
        margin-bottom: 15px;
      }
      .movie-title {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 5px 0;
      }
      .movie-meta {
        color: #94a3b8;
        font-size: 14px;
        display: flex;
        gap: 15px;
        align-items: center;
      }
      .server-bar {
        background: #1e293b;
        padding: 12px;
        border-radius: 8px;
        margin: 15px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border: 1px solid #334155;
      }
      .server-btn {
        background: #0f172a;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.2s;
      }
      .server-btn.active {
        background: #0284c7;
        color: white;
        border-color: #0284c7;
      }
      .player-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #334155;
        background: #000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .player-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Comment System Styling */
      .comments-section {
        margin-top: 35px;
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #334155;
      }
      .comment-input-box {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 20px;
      }
      .comment-input, .comment-textarea {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
      }
      .comment-textarea {
        resize: vertical;
        min-height: 70px;
      }
      .comment-btn {
        align-self: flex-start;
        background: #0284c7;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .comment-btn:hover {
        background: #0369a1;
      }
      .comment-card {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 10px;
      }
      .comment-author {
        font-weight: bold;
        color: #38bdf8;
        font-size: 13px;
      }
      .comment-date {
        font-size: 11px;
        color: #64748b;
        margin-left: 8px;
      }
      .comment-text {
        font-size: 14px;
        color: #cbd5e1;
        margin-top: 6px;
        line-height: 1.4;
      }
      .load-more-btn {
        width: 100%;
        background: #334155;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 10px;
      }

      .grid-recommendations {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 15px;
      }
      .rec-card {
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #334155;
        text-decoration: none;
        color: white;
        transition: transform 0.2s;
      }
      .rec-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <div class="movie-header">
        <h1 class="movie-title">{movie.title} ({movie.release_date ? movie.release_date.split('-')[0] : ''})</h1>
        <div class="movie-meta">
          <span>⭐ {movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'} / 10</span>
          <span>⏱️ {movie.runtime ? `${movie.runtime} mins` : 'N/A'}</span>
          <span style="color: #38bdf8; font-weight: bold;">HD</span>
        </div>
      </div>

      <!-- Server Switcher Bar -->
      <div class="server-bar">
        <span style="font-size: 14px; font-weight: 600; color: #94a3b8;">Select Server:</span>
        <button class="server-btn active" onclick="switchServer('autoembed')">Server 1 (AutoEmbed)</button>
        <button class="server-btn" onclick="switchServer('vidsrc')">Server 2 (VidSrc)</button>
        <button class="server-btn" onclick="switchServer('smashy')">Server 3 (SmashyStream)</button>
      </div>

      <!-- Video Player Frame -->
      <div class="player-container">
        <iframe 
          id="movie-player"
          class="player-iframe"
          src={`https://autoembed.co/movie/tmdb/${id}`} 
          allowfullscreen>
        </iframe>
      </div>

      <!-- Overview -->
      <div style="margin-top: 25px;">
        <h2 style="font-size: 18px;">Overview</h2>
        <p style="color: #cbd5e1; line-height: 1.6; font-size: 14px;">{movie.overview}</p>
      </div>

      <!-- Native Comment Section -->
      <div class="comments-section">
        <h2 style="font-size: 18px; margin-top: 0; margin-bottom: 15px;">💬 Comments</h2>
        
        <div class="comment-input-box">
          <input type="text" id="user-name" placeholder="Your Name..." class="comment-input" />
          <textarea id="user-comment" placeholder="Write a comment..." class="comment-textarea"></textarea>
          <button onclick="addComment()" class="comment-btn">Post Comment</button>
        </div>

        <div id="comments-list"></div>
        <button id="load-more-btn" onclick="showAllComments()" class="load-more-btn" style="display: none;">View More Comments</button>
      </div>

      <!-- Similar Movies Recommendations -->
      {similarMovies.length > 0 && (
        <div style="margin-top: 35px;">
          <h2 style="font-size: 18px; margin-bottom: 15px;">You May Also Like</h2>
          <div class="grid-recommendations">
            {similarMovies.map((sim) => (
              <a href={`/movie/${sim.id}`} class="rec-card">
                <img src={sim.poster_path ? `https://image.tmdb.org/t/p/w500${sim.poster_path}` : 'https://via.placeholder.com/500x750'} alt={sim.title} style="width: 100%; aspect-ratio: 2/3; object-fit: cover; display: block;" />
                <div style="padding: 8px;">
                  <h3 style="font-size: 12px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{sim.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <script is:inline define:vars={{ tmdbId: id }}>
      function switchServer(server) {
        const player = document.getElementById('movie-player');
        const buttons = document.querySelectorAll('.server-btn');
        
        buttons.forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');

        if (server === 'vidsrc') {
          player.src = `https://vidsrc.me/embed/movie?tmdb=${tmdbId}`;
        } else if (server === 'smashy') {
          player.src = `https://embed.smashystream.com/playere.php?tmdb=${tmdbId}`;
        } else {
          player.src = `https://autoembed.co/movie/tmdb/${tmdbId}`;
        }
      }

      // Local Comment Management Logic
      const storageKey = 'vix_comments_movie_' + tmdbId;
      let allComments = JSON.parse(localStorage.getItem(storageKey) || '[]');
      let showingAll = false;

      function renderComments() {
        const listDiv = document.getElementById('comments-list');
        const loadBtn = document.getElementById('load-more-btn');
        listDiv.innerHTML = '';

        if (allComments.length === 0) {
          listDiv.innerHTML = '<p style="color: #64748b; font-size: 13px;">No comments yet. Be the first to comment!</p>';
          loadBtn.style.display = 'none';
          return;
        }

        const visibleComments = showingAll ? allComments : allComments.slice(0, 5);

        visibleComments.forEach(c => {
          const card = document.createElement('div');
          card.className = 'comment-card';
          card.innerHTML = `
            <div>
              <span class="comment-author">${escapeHtml(c.name)}</span>
              <span class="comment-date">${c.date}</span>
            </div>
            <div class="comment-text">${escapeHtml(c.text)}</div>
          `;
          listDiv.appendChild(card);
        });

        if (allComments.length > 5 && !showingAll) {
          loadBtn.style.display = 'block';
          loadBtn.innerText = `View More Comments (${allComments.length - 5} remaining)`;
        } else {
          loadBtn.style.display = 'none';
        }
      }

      function addComment() {
        const nameInput = document.getElementById('user-name');
        const commentInput = document.getElementById('user-comment');

        const name = nameInput.value.trim() || 'Anonymous User';
        const text = commentInput.value.trim();

        if (!text) {
          alert('Please enter a comment before posting.');
          return;
        }

        const newComment = {
          name: name,
          text: text,
          date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        };

        allComments.unshift(newComment); // Add to top
        localStorage.setItem(storageKey, JSON.stringify(allComments));

        commentInput.value = '';
        renderComments();
      }

      function showAllComments() {
        showingAll = true;
        renderComments();
      }

      function escapeHtml(text) {
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      // Initial Render
      renderComments();
    </script>
  </body>
</html>
