---
import Navbar from '../../components/Navbar.astro';

const { id } = Astro.params;
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Movie Details
const res = await fetch(`https://api.themoviedb.org/3/movie/${id}?api_key=${TMDB_KEY}`);
const movie = await res.json();

// Fetch Similar Movies
const simRes = await fetch(`https://api.themoviedb.org/3/movie/${id}/similar?api_key=${TMDB_KEY}`);
const simData = await simRes.json();
const similarMovies = (simData.results || []).slice(0, 6);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Watch {movie.title || 'Movie'} Free HD - Vix Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .movie-header {
        margin-top: 15px;
        margin-bottom: 15px;
      }
      .movie-title {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 5px 0;
      }
      .movie-meta {
        color: #94a3b8;
        font-size: 14px;
        display: flex;
        gap: 15px;
        align-items: center;
      }
      .server-bar {
        background: #1e293b;
        padding: 12px;
        border-radius: 8px;
        margin: 15px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border: 1px solid #334155;
      }
      .server-btn {
        background: #0f172a;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.2s;
      }
      .server-btn.active {
        background: #0284c7;
        color: white;
        border-color: #0284c7;
      }
      .player-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #334155;
        background: #000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .player-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .subscribe-box {
        background: linear-gradient(135deg, #0284c7 0%, #0f172a 100%);
        border: 1px solid #38bdf8;
        border-radius: 12px;
        padding: 20px;
        margin-top: 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 10px;
      }
      .sub-input {
        padding: 10px 14px;
        border-radius: 6px;
        border: 1px solid #334155;
        background: #0f172a;
        color: white;
        width: 100%;
        max-width: 300px;
        outline: none;
      }
      .sub-btn {
        background: #38bdf8;
        color: #0f172a;
        font-weight: bold;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
      }
      .grid-recommendations {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 15px;
      }
      .rec-card {
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #334155;
        text-decoration: none;
        color: white;
        transition: transform 0.2s;
      }
      .rec-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <div class="movie-header">
        <h1 class="movie-title">{movie.title} ({movie.release_date ? movie.release_date.split('-')[0] : ''})</h1>
        <div class="movie-meta">
          <span>⭐ {movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'} / 10</span>
          <span>⏱️ {movie.runtime ? `${movie.runtime} mins` : 'N/A'}</span>
          <span style="color: #38bdf8; font-weight: bold;">HD</span>
        </div>
      </div>

      <!-- Server Switcher Bar -->
      <div class="server-bar">
        <span style="font-size: 14px; font-weight: 600; color: #94a3b8;">Select Server:</span>
        <button class="server-btn active" onclick="switchServer('autoembed')">Server 1 (AutoEmbed)</button>
        <button class="server-btn" onclick="switchServer('vidsrc')">Server 2 (VidSrc)</button>
        <button class="server-btn" onclick="switchServer('smashy')">Server 3 (SmashyStream)</button>
      </div>

      <!-- Video Player Frame -->
      <div class="player-container">
        <iframe 
          id="movie-player"
          class="player-iframe"
          src={`https://autoembed.co/movie/tmdb/${id}`} 
          allowfullscreen>
        </iframe>
      </div>

      <!-- Overview -->
      <div style="margin-top: 25px;">
        <h2 style="font-size: 18px;">Overview</h2>
        <p style="color: #cbd5e1; line-height: 1.6; font-size: 14px;">{movie.overview}</p>
      </div>

      <!-- Subscribe Box -->
      <div class="subscribe-box">
        <h3 style="margin: 0; font-size: 18px;">🔔 Get Latest Movies & Series Updates</h3>
        <p style="margin: 0; font-size: 13px; color: #cbd5e1;">Subscribe to receive updates on newly added HD movies.</p>
        <div style="display: flex; gap: 8px; width: 100%; justify-content: center; flex-wrap: wrap; margin-top: 5px;">
          <input type="email" id="sub-email" placeholder="Enter your email address..." class="sub-input" />
          <button onclick="handleSubscribe()" class="sub-btn">Subscribe Free</button>
        </div>
        <div id="sub-msg" style="font-size: 13px; color: #4ade80; display: none; margin-top: 5px;">Thank you for subscribing!</div>
      </div>

      <!-- Comment Section (Disqus Embed) -->
      <div style="margin-top: 35px; background: #1e293b; padding: 20px; border-radius: 12px; border: 1px solid #334155;">
        <h2 style="font-size: 18px; margin-top: 0; margin-bottom: 20px;">💬 Discussion & Comments</h2>
        <div id="disqus_thread"></div>
      </div>

      <!-- Similar Movies Recommendations -->
      {similarMovies.length > 0 && (
        <div style="margin-top: 35px;">
          <h2 style="font-size: 18px; margin-bottom: 15px;">You May Also Like</h2>
          <div class="grid-recommendations">
            {similarMovies.map((sim) => (
              <a href={`/movie/${sim.id}`} class="rec-card">
                <img src={sim.poster_path ? `https://image.tmdb.org/t/p/w500${sim.poster_path}` : 'https://via.placeholder.com/500x750'} alt={sim.title} style="width: 100%; aspect-ratio: 2/3; object-fit: cover; display: block;" />
                <div style="padding: 8px;">
                  <h3 style="font-size: 12px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{sim.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <script is:inline define:vars={{ tmdbId: id }}>
      function switchServer(server) {
        const player = document.getElementById('movie-player');
        const buttons = document.querySelectorAll('.server-btn');
        
        buttons.forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');

        if (server === 'vidsrc') {
          player.src = `https://vidsrc.me/embed/movie?tmdb=${tmdbId}`;
        } else if (server === 'smashy') {
          player.src = `https://embed.smashystream.com/playere.php?tmdb=${tmdbId}`;
        } else {
          player.src = `https://autoembed.co/movie/tmdb/${tmdbId}`;
        }
      }

      function handleSubscribe() {
        const email = document.getElementById('sub-email').value;
        if(email && email.includes('@')) {
          document.getElementById('sub-msg').style.display = 'block';
          document.getElementById('sub-email').value = '';
        } else {
          alert('Please enter a valid email address.');
        }
      }

      // Disqus Comment System Configuration
      var disqus_config = function () {
        this.page.url = window.location.href;
        this.page.identifier = 'movie_' + tmdbId;
      };
      (function() {
        var d = document, s = d.createElement('script');
        s.src = 'https://vixmovies.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
      })();
    </script>
  </body>
</html>
