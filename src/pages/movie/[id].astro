---
import Navbar from '../../components/Navbar.astro';

const { id } = Astro.params;
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

const slugify = (t = '') =>
  t.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// Fetch Movie Details (+ cast, crew, trailer, streaming availability)
const res = await fetch(
  `https://api.themoviedb.org/3/movie/${id}?api_key=${TMDB_KEY}&append_to_response=credits,videos,watch/providers`
);
const movie = await res.json();
if (!movie.id) {
  return new Response('Not found', { status: 404 });
}

// Fetch Similar Movies (only ones that have a poster)
const simRes = await fetch(`https://api.themoviedb.org/3/movie/${id}/similar?api_key=${TMDB_KEY}`);
const simData = await simRes.json();
const similarMovies = (simData.results || []).filter((m) => m.poster_path).slice(0, 6);

// Basic data
const SITE_URL = 'https://movies.vixtube.net';
const movieTitle = movie.title || 'Movie Details';
const releaseYear = movie.release_date ? movie.release_date.split('-')[0] : '';
const titleYear = `${movieTitle}${releaseYear ? ` (${releaseYear})` : ''}`;
const crew = movie.credits?.crew || [];
const castAll = movie.credits?.cast || [];
const cast = castAll.slice(0, 6);
const castRoles = castAll.slice(0, 10);
const directorObj = crew.find((c) => c.job === 'Director');
const director = directorObj?.name;
const writers = [
  ...new Set(
    crew
      .filter((c) => ['Screenplay', 'Writer', 'Story'].includes(c.job))
      .map((c) => c.name)
  ),
].slice(0, 3);
const trailer = (movie.videos?.results || []).find(
  (v) => v.site === 'YouTube' && v.type === 'Trailer'
);
const genres = movie.genres || [];
const genreNames = genres.map((g) => g.name);
const genreText = genreNames.join(', ').toLowerCase() || 'feature';
const article = /^[aeiou]/.test(genreText) ? 'an' : 'a';

// Helpers
const money = (n) =>
  n > 0
    ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n)
    : '';
const runtimeText = movie.runtime
  ? `${movie.runtime} minutes (${Math.floor(movie.runtime / 60)}h ${movie.runtime % 60}m)`
  : '';
const releaseDateText = movie.release_date
  ? new Date(movie.release_date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : '';

// Streaming availability (data by JustWatch via TMDB)
const COUNTRIES = {
  US: 'United States',
  GB: 'United Kingdom',
  IN: 'India',
  CA: 'Canada',
  AU: 'Australia',
  LK: 'Sri Lanka',
};
const provData = movie['watch/providers']?.results || {};
const names = (arr) => (arr || []).map((x) => x.provider_name).slice(0, 6).join(', ');
const providerRows = Object.entries(COUNTRIES)
  .map(([code, name]) => {
    const p = provData[code];
    if (!p) return null;
    const stream = names(p.flatrate);
    const rent = names(p.rent);
    const buy = names(p.buy);
    if (!stream && !rent && !buy) return null;
    return { code, name, stream, rent, buy };
  })
  .filter(Boolean);

// Summary paragraph (built from real data)
const summary = `${titleYear} is ${article} ${genreText} film${
  movie.runtime ? ` with a runtime of ${movie.runtime} minutes` : ''
}${director ? `, directed by ${director}` : ''}${
  cast.length ? `, starring ${cast.slice(0, 3).map((c) => c.name).join(', ')}` : ''
}. It holds a ${movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'}/10 rating on TMDB${
  movie.vote_count ? ` from ${movie.vote_count} votes` : ''
}.`;

// FAQ (every answer comes from real data, and is shown on the page)
const faqs = [];
if (director) {
  faqs.push({ q: `Who directed ${titleYear}?`, a: `${movieTitle} was directed by ${director}.` });
}
if (castRoles.length) {
  const list = castRoles
    .slice(0, 5)
    .map((c) => (c.character ? `${c.name} (as ${c.character})` : c.name))
    .join(', ');
  faqs.push({ q: `Who stars in ${movieTitle}?`, a: `The main cast of ${movieTitle} includes ${list}.` });
}
if (runtimeText) {
  faqs.push({ q: `How long is ${movieTitle}?`, a: `${movieTitle} has a runtime of ${runtimeText}.` });
}
if (releaseDateText) {
  faqs.push({ q: `When was ${movieTitle} released?`, a: `${movieTitle} was released on ${releaseDateText}.` });
}
if (genreNames.length) {
  faqs.push({ q: `What genre is ${movieTitle}?`, a: `${movieTitle} is ${article} ${genreText} film.` });
}
if (movie.vote_count > 0 && movie.vote_average) {
  faqs.push({
    q: `What is the rating of ${movieTitle}?`,
    a: `${movieTitle} has a rating of ${movie.vote_average.toFixed(1)}/10 on TMDB, based on ${movie.vote_count} votes.`,
  });
}
if (providerRows.length) {
  const parts = providerRows.map((r) => {
    const bits = [];
    if (r.stream) bits.push(`streaming on ${r.stream}`);
    if (r.rent) bits.push(`rent on ${r.rent}`);
    if (r.buy) bits.push(`buy on ${r.buy}`);
    return `${r.name}: ${bits.join('; ')}`;
  });
  faqs.push({
    q: `Where can I watch ${movieTitle} legally?`,
    a: `According to JustWatch data provided by TMDB, ${movieTitle} is available in these places. ${parts.join('. ')}.`,
  });
}
if (movie.belongs_to_collection?.name) {
  faqs.push({
    q: `Is ${movieTitle} part of a series?`,
    a: `Yes, ${movieTitle} is part of the ${movie.belongs_to_collection.name}.`,
  });
}
if (money(movie.budget)) {
  faqs.push({ q: `What was the budget of ${movieTitle}?`, a: `The reported budget of ${movieTitle} was ${money(movie.budget)}.` });
}
if (money(movie.revenue)) {
  faqs.push({ q: `How much did ${movieTitle} earn?`, a: `${movieTitle} earned a reported ${money(movie.revenue)} worldwide.` });
}

// Thin pages (no overview or almost no votes) should not be indexed
const isThin = !movie.overview || (movie.vote_count || 0) < 5;
const robotsContent = isThin
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const pageTitle = `${titleYear} - Cast, Trailer & Details | Vix Movies`;
const pageDescription = summary.length > 158 ? summary.slice(0, 155) + '...' : summary;
const posterUrl = movie.poster_path ? `https://image.tmdb.org/t/p/w500${movie.poster_path}` : `${SITE_URL}/no-poster.svg`;
const backdropUrl = movie.backdrop_path ? `https://image.tmdb.org/t/p/w1280${movie.backdrop_path}` : posterUrl;
// Smaller image for the click-to-load player thumbnail
const facadeUrl = movie.backdrop_path ? `https://image.tmdb.org/t/p/w780${movie.backdrop_path}` : posterUrl;
const pageUrl = `${SITE_URL}/movie/${id}`;

// Breadcrumb points to the first genre page (a real page)
const firstGenre = genres[0];
const breadcrumb = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
  ...(firstGenre
    ? [{
        "@type": "ListItem",
        "position": 2,
        "name": `${firstGenre.name} Movies`,
        "item": `${SITE_URL}/genre/${slugify(firstGenre.name)}`,
      }]
    : []),
  { "@type": "ListItem", "position": firstGenre ? 3 : 2, "name": movieTitle, "item": pageUrl },
];

// Schema.org Structured Data
const schemaGraph = [
  {
    "@type": "Movie",
    "@id": pageUrl,
    "url": pageUrl,
    "name": movieTitle,
    "image": posterUrl,
    "description": movie.overview || pageDescription,
    "datePublished": movie.release_date || releaseYear,
    "duration": movie.runtime ? `PT${movie.runtime}M` : undefined,
    "genre": genreNames,
    "director": director
      ? { "@type": "Person", "name": director, "url": `${SITE_URL}/person/${directorObj.id}` }
      : undefined,
    "actor": cast.map((c) => ({ "@type": "Person", "name": c.name, "url": `${SITE_URL}/person/${c.id}` }))
  },
  { "@type": "BreadcrumbList", "itemListElement": breadcrumb },
];
if (faqs.length) {
  schemaGraph.push({
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  });
}
const movieSchema = { "@context": "https://schema.org", "@graph": schemaGraph };
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Vix Movies" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="video.movie" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={backdropUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={backdropUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(movieSchema)} />

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .movie-header {
        margin-top: 15px;
        margin-bottom: 15px;
      }
      .movie-title {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 5px 0;
      }
      .movie-meta {
        color: #94a3b8;
        font-size: 14px;
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
      }
      .movie-meta a {
        color: inherit;
        text-decoration: underline;
      }
      .server-bar {
        background: #1e293b;
        padding: 12px;
        border-radius: 8px;
        margin: 15px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border: 1px solid #334155;
      }
      .server-btn {
        background: #0f172a;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.2s;
      }
      .server-btn.active {
        background: #0284c7;
        color: white;
        border-color: #0284c7;
      }
      .player-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #334155;
        background: #000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .player-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Click-to-load player thumbnail */
      .facade {
        cursor: pointer;
      }
      .facade-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.7);
      }
      .facade-play {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 72px;
        height: 72px;
        background: rgba(2, 132, 199, 0.95);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: #fff;
        padding-left: 4px;
      }
      .facade-label {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 14px;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        color: #e2e8f0;
      }

      /* Action Bar (Like & Share) */
      .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #1e293b;
        padding: 12px 16px;
        border-radius: 8px;
        margin-top: 15px;
        border: 1px solid #334155;
        flex-wrap: wrap;
        gap: 12px;
      }
      .vote-container, .share-container {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .share-title {
        font-size: 13px;
        color: #94a3b8;
        font-weight: 600;
      }
      .vote-btn {
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid #334155;
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s;
      }
      .vote-btn:hover {
        background: #334155;
      }
      .vote-btn.active-like {
        background: #22c55e;
        border-color: #22c55e;
        color: white;
      }
      .vote-btn.active-dislike {
        background: #ef4444;
        border-color: #ef4444;
        color: white;
      }
      .share-btn {
        border: none;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.2s;
      }
      .share-btn:hover {
        opacity: 0.85;
      }
      .share-btn.wa { background: #25D366; }
      .share-btn.fb { background: #1877F2; }
      .share-btn.tg { background: #229ED9; }
      .share-btn.copy { background: #475569; }

      /* Movie Information Block */
      .movie-info-block {
        margin-top: 25px;
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #334155;
      }
      .movie-info-block h2 {
        font-size: 18px;
        color: #38bdf8;
        margin-top: 0;
      }
      .movie-info-block h2:not(:first-child) {
        margin-top: 24px;
      }
      .movie-info-block p {
        color: #cbd5e1;
        line-height: 1.6;
        font-size: 14px;
      }
      .details-list, .cast-list, .provider-list {
        color: #cbd5e1;
        font-size: 14px;
        line-height: 1.8;
        padding-left: 18px;
        margin: 0;
      }
      .details-list a, .cast-list a {
        color: #38bdf8;
        text-decoration: none;
      }
      .details-list a:hover, .cast-list a:hover {
        text-decoration: underline;
      }
      .faq-item h3 {
        font-size: 15px;
        color: #f8fafc;
        margin: 14px 0 4px 0;
      }
      .faq-item p {
        margin: 0;
      }
      .attribution {
        font-size: 11px;
        color: #64748b;
        margin-top: 8px;
      }
      .ad-slot {
        margin: 24px 0;
        text-align: center;
        min-height: 90px;
      }

      /* Comment System Styling */
      .comments-section {
        margin-top: 35px;
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #334155;
      }
      .comment-input-box {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 20px;
      }
      .comment-input, .comment-textarea {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
      }
      .comment-textarea {
        resize: vertical;
        min-height: 70px;
      }
      .comment-btn {
        align-self: flex-start;
        background: #0284c7;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .comment-btn:hover {
        background: #0369a1;
      }
      .comment-card {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 10px;
      }
      .comment-author {
        font-weight: bold;
        color: #38bdf8;
        font-size: 13px;
      }
      .comment-date {
        font-size: 11px;
        color: #64748b;
        margin-left: 8px;
      }
      .comment-text {
        font-size: 14px;
        color: #cbd5e1;
        margin-top: 6px;
        line-height: 1.4;
      }
      .load-more-btn {
        width: 100%;
        background: #334155;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        margin-top: 10px;
      }

      .grid-recommendations {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 15px;
      }
      .rec-card {
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #334155;
        text-decoration: none;
        color: white;
        transition: transform 0.2s;
      }
      .rec-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
      }

      /* Site Footer */
      .site-footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #334155;
        text-align: center;
      }
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 12px;
      }
      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
      }
      .footer-links a:hover {
        color: #38bdf8;
      }
      .copyright-text {
        color: #64748b;
        font-size: 12px;
        margin: 0 0 8px 0;
      }
      .tmdb-note {
        color: #64748b;
        font-size: 11px;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <main>
        <!-- Header Title Section -->
        <header class="movie-header">
          <h1 class="movie-title">{titleYear}</h1>
          <div class="movie-meta">
            <span>⭐ {movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'} / 10 Rating</span>
            <span>⏱️ {movie.runtime ? `${movie.runtime} mins` : 'N/A'}</span>
            <span style="color: #38bdf8; font-weight: bold;">HD Quality</span>
            {genres.length > 0 && (
              <span>
                🎭{' '}
                {genres.map((g, i) => (
                  <>
                    <a href={`/genre/${slugify(g.name)}`}>{g.name}</a>{i < genres.length - 1 ? ', ' : ''}
                  </>
                ))}
              </span>
            )}
          </div>
        </header>

        <!-- Server Switcher Bar (Server 2 is the default) -->
        <nav class="server-bar" aria-label="Streaming Server Selection">
          <span style="font-size: 14px; font-weight: 600; color: #94a3b8;">Select Server:</span>
          <button class="server-btn" data-server="autoembed">Server 1 (AutoEmbed)</button>
          <button class="server-btn active" data-server="vidsrc">Server 2 (VidSrc)</button>
          <button class="server-btn" data-server="smashy">Server 3 (SmashyStream)</button>
        </nav>

        <!-- Click-to-load player: the player loads only after the visitor clicks -->
        <section
          id="player-box"
          class="player-container facade"
          role="button"
          tabindex="0"
          aria-label={`Play ${movieTitle}`}>
          <img class="facade-img" src={facadeUrl} alt={`Watch ${movieTitle}`} width="780" height="439" decoding="async" fetchpriority="high" />
          <span class="facade-play">▶</span>
          <span class="facade-label">Click to play</span>
        </section>

        <!-- Action Bar (Like & Share) -->
        <div class="action-bar">
          <div class="vote-container">
            <button id="like-btn" class="vote-btn" aria-label="Like movie">
              👍 <span id="like-count">0</span>
            </button>
            <button id="dislike-btn" class="vote-btn" aria-label="Dislike movie">
              👎 <span id="dislike-count">0</span>
            </button>
          </div>

          <div class="share-container">
            <span class="share-title">Share:</span>
            <button id="share-wa" class="share-btn wa">WhatsApp</button>
            <button id="share-fb" class="share-btn fb">Facebook</button>
            <button id="share-tg" class="share-btn tg">Telegram</button>
            <button id="copy-link" class="share-btn copy">📋 Copy Link</button>
          </div>
        </div>

        <!-- Overview, Details, Cast, Where to Watch, FAQ & Trailer -->
        <article class="movie-info-block">
          <h2>Storyline & Overview</h2>
          <p>{movie.overview || 'No storyline overview available for this title.'}</p>
          <p>{summary}</p>

          <h2>Details</h2>
          <ul class="details-list">
            {movie.tagline && <li><b>Tagline:</b> {movie.tagline}</li>}
            {movie.original_title && movie.original_title !== movie.title && (
              <li><b>Original title:</b> {movie.original_title}</li>
            )}
            {releaseDateText && <li><b>Release date:</b> {releaseDateText}</li>}
            {runtimeText && <li><b>Runtime:</b> {runtimeText}</li>}
            {movie.status && <li><b>Status:</b> {movie.status}</li>}
            {director && <li><b>Director:</b> <a href={`/person/${directorObj.id}`}>{director}</a></li>}
            {writers.length > 0 && <li><b>Writers:</b> {writers.join(', ')}</li>}
            {movie.spoken_languages?.length > 0 && (
              <li><b>Languages:</b> {movie.spoken_languages.map((l) => l.english_name).join(', ')}</li>
            )}
            {movie.production_countries?.length > 0 && (
              <li><b>Countries:</b> {movie.production_countries.map((c) => c.name).join(', ')}</li>
            )}
            {movie.production_companies?.length > 0 && (
              <li><b>Production:</b> {movie.production_companies.slice(0, 3).map((c) => c.name).join(', ')}</li>
            )}
            {movie.belongs_to_collection?.name && (
              <li><b>Collection:</b> {movie.belongs_to_collection.name}</li>
            )}
            {money(movie.budget) && <li><b>Budget:</b> {money(movie.budget)}</li>}
            {money(movie.revenue) && <li><b>Box office:</b> {money(movie.revenue)}</li>}
          </ul>

          <!-- Ad slot: Native Banner (Adsterra) -->
          <div class="ad-slot">
            <script async data-cfasync="false" src="https://toleranceteaminadequate.com/e9a7ebb5b4ccad1a0f4057850ab50885/invoke.js"></script>
            <div id="container-e9a7ebb5b4ccad1a0f4057850ab50885"></div>
          </div>

          {castRoles.length > 0 && (
            <>
              <h2>Cast & Characters</h2>
              <ul class="cast-list">
                {castRoles.map((c) => (
                  <li>
                    <a href={`/person/${c.id}`}><b>{c.name}</b></a>{c.character ? ` as ${c.character}` : ''}
                  </li>
                ))}
              </ul>
            </>
          )}

          {providerRows.length > 0 && (
            <>
              <h2>Where to Watch {movieTitle} Legally</h2>
              <ul class="provider-list">
                {providerRows.map((r) => (
                  <li>
                    <b>{r.name}:</b>
                    {r.stream && ` Stream on ${r.stream}.`}
                    {r.rent && ` Rent on ${r.rent}.`}
                    {r.buy && ` Buy on ${r.buy}.`}
                  </li>
                ))}
              </ul>
              <p class="attribution">Streaming availability data provided by JustWatch via TMDB.</p>
            </>
          )}

          {faqs.length > 0 && (
            <>
              <h2>Frequently Asked Questions about {movieTitle}</h2>
              {faqs.map((f) => (
                <div class="faq-item">
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </div>
              ))}
            </>
          )}

          {trailer && (
            <>
              <h2>Trailer</h2>
              <div class="player-container">
                <iframe
                  class="player-iframe"
                  src={`https://www.youtube.com/embed/${trailer.key}`}
                  title={`${movieTitle} trailer`}
                  loading="lazy"
                  allowfullscreen>
                </iframe>
              </div>
            </>
          )}
        </article>

        <!-- Native Comment Section -->
        <section class="comments-section" aria-label="User Reviews and Comments">
          <h2 style="font-size: 18px; margin-top: 0; margin-bottom: 15px;">💬 User Comments & Reviews</h2>

          <div class="comment-input-box">
            <input type="text" id="user-name" placeholder="Your Name..." class="comment-input" />
            <textarea id="user-comment" placeholder="Write your review or comment..." class="comment-textarea"></textarea>
            <button id="post-btn" class="comment-btn">Post Comment</button>
          </div>

          <div id="comments-list"></div>
          <button id="load-more-btn" class="load-more-btn" style="display: none;">View More Comments</button>
        </section>

        <!-- Similar Movies Recommendations -->
        {similarMovies.length > 0 && (
          <section style="margin-top: 35px;" aria-label="Recommended Movies">
            <h2 style="font-size: 18px; margin-bottom: 15px;">You May Also Like</h2>
            <div class="grid-recommendations">
              {similarMovies.map((sim) => (
                <a href={`/movie/${sim.id}`} class="rec-card" title={`Watch ${sim.title}`}>
                  <img src={`https://image.tmdb.org/t/p/w500${sim.poster_path}`} onerror="this.onerror=null;this.src='/no-poster.svg'" alt={`${sim.title} Poster`} style="width: 100%; height: auto; aspect-ratio: 2/3; object-fit: cover; display: block;" loading="lazy" decoding="async" width="500" height="750" />
                  <div style="padding: 8px;">
                    <h3 style="font-size: 12px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{sim.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </main>

      <!-- Footer -->
      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
        <p class="tmdb-note">This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
      </footer>
    </div>

    <script is:inline define:vars={{ tmdbId: id, movieTitle: movieTitle }}>
      document.addEventListener('DOMContentLoaded', () => {
        // Click-to-load player + server switcher
        const serverButtons = document.querySelectorAll('.server-btn');
        const box = document.getElementById('player-box');
        let currentServer = 'vidsrc';
        let iframe = null;

        function srcFor(server) {
          if (server === 'vidsrc') return `https://vidsrc.me/embed/movie?tmdb=${tmdbId}`;
          if (server === 'smashy') return `https://embed.smashystream.com/playere.php?tmdb=${tmdbId}`;
          return `https://autoembed.co/movie/tmdb/${tmdbId}`;
        }

        function loadPlayer() {
          const src = srcFor(currentServer);
          if (!iframe) {
            iframe = document.createElement('iframe');
            // Inline style: page styles do not reach elements created by JavaScript
            iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;';
            iframe.setAttribute('frameborder', '0');
            iframe.title = 'Watch ' + movieTitle;
            iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
            iframe.allowFullscreen = true;
            iframe.src = src;
            box.replaceChildren(iframe);
            box.classList.remove('facade');
            box.removeAttribute('role');
            box.removeAttribute('tabindex');
            box.removeAttribute('aria-label');
          } else if (iframe.getAttribute('src') !== src) {
            iframe.src = src;
          }
        }

        box.addEventListener('click', loadPlayer);
        box.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            loadPlayer();
          }
        });

        serverButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            serverButtons.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            currentServer = e.target.getAttribute('data-server');
            loadPlayer();
          });
        });

        // Like / Dislike Logic
        const likeKey = `vix_like_movie_${tmdbId}`;
        const dislikeKey = `vix_dislike_movie_${tmdbId}`;
        const userVoteKey = `vix_uservote_movie_${tmdbId}`;

        const likeBtn = document.getElementById('like-btn');
        const dislikeBtn = document.getElementById('dislike-btn');
        const likeCountEl = document.getElementById('like-count');
        const dislikeCountEl = document.getElementById('dislike-count');

        let likes = parseInt(localStorage.getItem(likeKey) || '0');
        let dislikes = parseInt(localStorage.getItem(dislikeKey) || '0');
        let userVote = localStorage.getItem(userVoteKey);

        function renderVotes() {
          likeCountEl.innerText = likes;
          dislikeCountEl.innerText = dislikes;

          likeBtn.classList.remove('active-like');
          dislikeBtn.classList.remove('active-dislike');

          if (userVote === 'like') likeBtn.classList.add('active-like');
          if (userVote === 'dislike') dislikeBtn.classList.add('active-dislike');
        }

        likeBtn.addEventListener('click', () => {
          if (userVote === 'like') {
            likes--;
            userVote = null;
          } else {
            if (userVote === 'dislike') dislikes--;
            likes++;
            userVote = 'like';
          }
          localStorage.setItem(likeKey, likes);
          localStorage.setItem(dislikeKey, dislikes);
          if (userVote) localStorage.setItem(userVoteKey, userVote);
          else localStorage.removeItem(userVoteKey);
          renderVotes();
        });

        dislikeBtn.addEventListener('click', () => {
          if (userVote === 'dislike') {
            dislikes--;
            userVote = null;
          } else {
            if (userVote === 'like') likes--;
            dislikes++;
            userVote = 'dislike';
          }
          localStorage.setItem(likeKey, likes);
          localStorage.setItem(dislikeKey, dislikes);
          if (userVote) localStorage.setItem(userVoteKey, userVote);
          else localStorage.removeItem(userVoteKey);
          renderVotes();
        });

        renderVotes();

        // Share Buttons Logic
        const currentUrl = encodeURIComponent(window.location.href);
        const shareText = encodeURIComponent(`Watch "${movieTitle || 'Movie'}" for free in HD on Vix Movies!`);

        document.getElementById('share-wa').addEventListener('click', () => {
          window.open(`https://api.whatsapp.com/send?text=${shareText}%20${currentUrl}`, '_blank');
        });

        document.getElementById('share-fb').addEventListener('click', () => {
          window.open(`https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`, '_blank');
        });

        document.getElementById('share-tg').addEventListener('click', () => {
          window.open(`https://t.me/share/url?url=${currentUrl}&text=${shareText}`, '_blank');
        });

        document.getElementById('copy-link').addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard!');
        });

        // Comment System Logic
        const storageKey = 'vix_comments_movie_' + tmdbId;
        let allComments = JSON.parse(localStorage.getItem(storageKey) || '[]');
        let showingAll = false;

        const listDiv = document.getElementById('comments-list');
        const loadBtn = document.getElementById('load-more-btn');
        const postBtn = document.getElementById('post-btn');

        function renderComments() {
          listDiv.innerHTML = '';

          if (allComments.length === 0) {
            listDiv.innerHTML = '<p style="color: #64748b; font-size: 13px;">No comments yet. Be the first to comment!</p>';
            loadBtn.style.display = 'none';
            return;
          }

          const visibleComments = showingAll ? allComments : allComments.slice(0, 5);

          visibleComments.forEach(c => {
            const card = document.createElement('div');
            card.className = 'comment-card';
            card.innerHTML = `
              <div>
                <span class="comment-author">${escapeHtml(c.name)}</span>
                <span class="comment-date">${c.date}</span>
              </div>
              <div class="comment-text">${escapeHtml(c.text)}</div>
            `;
            listDiv.appendChild(card);
          });

          if (allComments.length > 5 && !showingAll) {
            loadBtn.style.display = 'block';
            loadBtn.innerText = `View More Comments (${allComments.length - 5} remaining)`;
          } else {
            loadBtn.style.display = 'none';
          }
        }

        postBtn.addEventListener('click', () => {
          const nameInput = document.getElementById('user-name');
          const commentInput = document.getElementById('user-comment');

          const name = nameInput.value.trim() || 'Anonymous User';
          const text = commentInput.value.trim();

          if (!text) {
            alert('Please enter a comment before posting.');
            return;
          }

          const newComment = {
            name: name,
            text: text,
            date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
          };

          allComments.unshift(newComment);
          localStorage.setItem(storageKey, JSON.stringify(allComments));

          commentInput.value = '';
          renderComments();
        });

        loadBtn.addEventListener('click', () => {
          showingAll = true;
          renderComments();
        });

        function escapeHtml(text) {
          return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        renderComments();
      });
    </script>
  </body>
</html>
