---
const { id } = Astro.params;
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Movie Details from TMDB
const res = await fetch(`https://api.themoviedb.org/3/movie/${id}?api_key=${TMDB_KEY}`);
const movie = await res.json();

// Multi-source Streaming Embed URLs
const server1 = `https://vidsrc.cc/v2/embed/movie/${id}`;
const server2 = `https://multiembed.mov/directstream.php?video_id=${id}&tmdb=1`;
const server3 = `https://autoembed.co/movie/tmdb/${id}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Watch {movie.title || 'Movie'} Free HD - Vix Movies</title>
  </head>
  <body style="background-color: #0f172a; color: white; font-family: sans-serif; padding: 15px; max-width: 900px; margin: 0 auto;">
    
    <a href="/" style="color: #38bdf8; text-decoration: none; font-size: 14px;">← Back to Home</a>
    
    <h1 style="font-size: 22px; margin-top: 15px;">{movie.title} ({movie.release_date ? movie.release_date.split('-')[0] : ''})</h1>
    <p style="color: #94a3b8; font-size: 14px;">⭐ {movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'} / 10</p>

    <!-- Server Selector Buttons -->
    <div style="margin-bottom: 10px; display: flex; gap: 10px; flex-wrap: wrap;">
      <button onclick={`document.getElementById('player').src='${server1}'`} style="background: #2563eb; color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer;">Server 1 (VidSrc)</button>
      <button onclick={`document.getElementById('player').src='${server2}'`} style="background: #059669; color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer;">Server 2 (MultiEmbed)</button>
      <button onclick={`document.getElementById('player').src='${server3}'`} style="background: #d97706; color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer;">Server 3 (AutoEmbed)</button>
    </div>

    <!-- Video Player Embed Container -->
    <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; border: 1px solid #334155; margin-top: 10px; background: #000;">
      <iframe 
        id="player"
        src={server2} 
        style="position: absolute; top:0; left: 0; width: 100%; height: 100%; border:0;" 
        allowfullscreen>
      </iframe>
    </div>

    <div style="margin-top: 20px;">
      <h2>Overview</h2>
      <p style="color: #cbd5e1; line-height: 1.6;">{movie.overview}</p>
    </div>

  </body>
</html>
