<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="video.other" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={video.thumb} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={video.thumb} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style>
      * { box-sizing: border-box; }
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container { max-width: 1100px; margin: 0 auto; }
      .title { font-size: 22px; font-weight: 800; margin: 18px 0 6px 0; line-height: 1.3; }
      .meta { color: #94a3b8; font-size: 13px; margin: 0 0 14px 0; }
      .notice {
        background: #1e293b; border: 1px solid #334155; border-radius: 8px;
        padding: 10px 14px; font-size: 13px; color: #cbd5e1; margin-bottom: 14px;
      }
      .player-container {
        position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;
        border-radius: 12px; border: 1px solid #334155; background: #000;
      }
      .player-iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
      .yt-facade { cursor: pointer; }
      .facade-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .facade-play {
        position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: 68px; height: 48px; background: rgba(2, 132, 199, 0.92); border-radius: 12px;
        display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff;
      }
      .yt-link { display: inline-block; margin-top: 10px; color: #38bdf8; font-size: 13px; }
      .info-block {
        margin-top: 22px; background: #1e293b; padding: 18px; border-radius: 12px; border: 1px solid #334155;
      }
      .info-block h2 { font-size: 16px; color: #38bdf8; margin: 0 0 10px 0; }
      .info-block h2:not(:first-child) { margin-top: 20px; }
      .info-block p { color: #cbd5e1; line-height: 1.6; font-size: 14px; margin: 0 0 8px 0; }
      .details-list { color: #cbd5e1; font-size: 14px; line-height: 1.8; padding-left: 18px; margin: 0; }
      .details-list a { color: #38bdf8; }
      .section-title { font-size: 16px; font-weight: 800; margin: 28px 0 12px 0; }
      .vid-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
      @media (min-width: 700px) {
        .vid-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
      @media (min-width: 950px) {
        .vid-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }
      .vid-card { text-decoration: none; color: white; display: flex; flex-direction: column; overflow: hidden; }
      .thumb-box {
        position: relative; border-radius: 10px; overflow: hidden; aspect-ratio: 16 / 9;
        background: #1e293b; border: 1px solid #334155;
      }
      .thumb-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .play-icon {
        position: absolute; right: 8px; bottom: 8px; background: rgba(2, 132, 199, 0.9);
        font-size: 11px; font-weight: bold; padding: 2px 7px; border-radius: 4px;
      }
      .vid-title {
        font-size: 13px; font-weight: 600; margin: 7px 0 3px 0; line-height: 1.35;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .vid-meta { font-size: 11px; color: #94a3b8; margin: 0; }
      .pill-list { display: flex; flex-wrap: wrap; gap: 8px; }
      .pill-list a {
        background: #1e293b; color: #cbd5e1; border: 1px solid #334155; padding: 6px 14px;
        border-radius: 20px; font-size: 12px; font-weight: 600; text-decoration: none;
      }
      .pill-list a.current { background: #0284c7; border-color: #0284c7; color: white; }
      .site-footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #334155; text-align: center; }
      .footer-links { display: flex; justify-content: center; gap: 20px; margin-bottom: 12px; }
      .footer-links a { color: #94a3b8; text-decoration: none; font-size: 13px; }
      .copyright-text { color: #64748b; font-size: 12px; margin: 0; }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <main>
        <h1 class="title">{video.title}</h1>
        <p class="meta">{video.channelTitle}{published ? ` • ${published}` : ''}</p>

        {video.live === 'upcoming' && (
          <div class="notice">🗓️ This stream is scheduled. The player will start when the broadcast goes live.</div>
        )}
        {video.live === 'live' && (
          <div class="notice">🔴 This stream is live right now.</div>
        )}

        <div
          class="player-container yt-facade"
          data-embed={`${embedUrl}?autoplay=1&rel=0`}
          data-title={video.title}
          role="button"
          tabindex="0"
          aria-label={`Play ${video.title}`}>
          <img class="facade-img" src={video.thumb} alt={video.title} decoding="async" width="480" height="270" />
          <span class="facade-play">▶</span>
          <noscript>
            <iframe class="player-iframe" src={embedUrl} title={video.title} allowfullscreen></iframe>
          </noscript>
        </div>
        <a class="yt-link" href={watchUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a>

        <article class="info-block">
          <h2>About this video</h2>
          <p>{aboutText}</p>
          {cleanDesc.length > 30 && <p>{cleanDesc}</p>}

          <h2>Video Details</h2>
          <ul class="details-list">
            <li><b>Channel:</b> {video.channelTitle}</li>
            {published && <li><b>Published:</b> {published}</li>}
            {durText && <li><b>Length:</b> {durText}</li>}
            {sport && (
              <li><b>Sport:</b> <a href={`/sports/${sport.slug}`}>{sport.name}</a></li>
            )}
            {video.live === 'live' && <li><b>Status:</b> Live now</li>}
            {video.live === 'upcoming' && <li><b>Status:</b> Scheduled</li>}
          </ul>
        </article>

        {related.length > 0 && (
          <section>
            <h2 class="section-title">More {sport.name} Videos</h2>
            <div class="vid-grid">
              {related.map((v) => (
                <a href={`/sports/watch/${v.id}`} class="vid-card" title={v.title}>
                  <div class="thumb-box">
                    <img src={v.thumb} alt={v.title} loading="lazy" decoding="async" width="480" height="270" />
                    <span class="play-icon">{v.live === 'live' ? 'LIVE' : '▶ Play'}</span>
                  </div>
                  <h3 class="vid-title">{v.title}</h3>
                  <p class="vid-meta">{v.channelTitle} • {fmtShort(v.published)}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <h2 class="section-title">Browse Sports</h2>
        <div class="pill-list">
          {SPORTS.map((s) => (
            <a href={`/sports/${s.slug}`} class={sport && s.slug === sport.slug ? 'current' : ''}>
              {s.emoji} {s.name}
            </a>
          ))}
        </div>
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
      </footer>
    </div>

    <script is:inline>
      // Click-to-load: the YouTube player loads only when the visitor taps the thumbnail
      document.querySelectorAll('.yt-facade').forEach((el) => {
        let done = false;
        const load = () => {
          if (done) return;
          done = true;
          const f = document.createElement('iframe');
          f.className = 'player-iframe';
          // Inline style: page styles do not reach elements created by JavaScript
          f.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;';
          f.setAttribute('frameborder', '0');
          f.src = el.dataset.embed;
          f.title = el.dataset.title || 'Video player';
          f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
          f.allowFullscreen = true;
          el.replaceChildren(f);
          el.classList.remove('yt-facade');
          el.removeAttribute('role');
          el.removeAttribute('tabindex');
        };
        el.addEventListener('click', load);
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            load();
          }
        });
      });
    </script>
  </body>
</html>
