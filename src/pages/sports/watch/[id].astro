---
import Navbar from '../../../components/Navbar.astro';
import { SPORTS } from '../../../utils/sports-config.js';
import { getVideo } from '../../../utils/youtube.js';

const { id } = Astro.params;
if (!/^[A-Za-z0-9_-]{11}$/.test(id || '')) {
  return new Response('Not found', { status: 404 });
}

const key = Astro.locals?.runtime?.env?.YOUTUBE_API_KEY || import.meta.env.YOUTUBE_API_KEY;
const video = key ? await getVideo(id, key) : null;
if (!video) {
  return new Response('Not found', { status: 404 });
}

const SITE_URL = 'https://movies.vixtube.net';
const pageUrl = `${SITE_URL}/sports/watch/${id}`;
const embedUrl = `https://www.youtube.com/embed/${id}`;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
const desc = video.description.replace(/\s+/g, ' ').trim().slice(0, 500);
const published = video.published
  ? new Date(video.published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '';
const pageTitle = `${video.title.slice(0, 80)} | Vix Movies Sports`;
const pageDescription = (desc || `Watch ${video.title} on the official ${video.channelTitle} channel.`).slice(0, 158);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoObject",
      "name": video.title,
      "description": desc || video.title,
      "thumbnailUrl": [video.thumb],
      "uploadDate": video.published,
      "embedUrl": embedUrl,
      "url": pageUrl
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
        { "@type": "ListItem", "position": 2, "name": "Sports", "item": `${SITE_URL}/sports` },
        { "@type": "ListItem", "position": 3, "name": video.title, "item": pageUrl }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="video.other" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={video.thumb} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={video.thumb} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style>
      * { box-sizing: border-box; }
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container { max-width: 1100px; margin: 0 auto; }
      .title { font-size: 22px; font-weight: 800; margin: 18px 0 6px 0; line-height: 1.3; }
      .meta { color: #94a3b8; font-size: 13px; margin: 0 0 14px 0; }
      .notice {
        background: #1e293b; border: 1px solid #334155; border-radius: 8px;
        padding: 10px 14px; font-size: 13px; color: #cbd5e1; margin-bottom: 14px;
      }
      .player-container {
        position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;
        border-radius: 12px; border: 1px solid #334155; background: #000;
      }
      .player-iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
      .yt-link { display: inline-block; margin-top: 10px; color: #38bdf8; font-size: 13px; }
      .info-block {
        margin-top: 22px; background: #1e293b; padding: 18px; border-radius: 12px; border: 1px solid #334155;
      }
      .info-block h2 { font-size: 16px; color: #38bdf8; margin: 0 0 10px 0; }
      .info-block p { color: #cbd5e1; line-height: 1.6; font-size: 14px; margin: 0; }
      .section-title { font-size: 16px; font-weight: 800; margin: 28px 0 12px 0; }
      .pill-list { display: flex; flex-wrap: wrap; gap: 8px; }
      .pill-list a {
        background: #1e293b; color: #cbd5e1; border: 1px solid #334155; padding: 6px 14px;
        border-radius: 20px; font-size: 12px; font-weight: 600; text-decoration: none;
      }
      .site-footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #334155; text-align: center; }
      .footer-links { display: flex; justify-content: center; gap: 20px; margin-bottom: 12px; }
      .footer-links a { color: #94a3b8; text-decoration: none; font-size: 13px; }
      .copyright-text { color: #64748b; font-size: 12px; margin: 0; }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <main>
        <h1 class="title">{video.title}</h1>
        <p class="meta">{video.channelTitle}{published ? ` • ${published}` : ''}</p>

        {video.live === 'upcoming' && (
          <div class="notice">🗓️ This stream is scheduled. The player will start when the broadcast goes live.</div>
        )}
        {video.live === 'live' && (
          <div class="notice">🔴 This stream is live right now.</div>
        )}

        <div class="player-container">
          <iframe
            class="player-iframe"
            src={embedUrl}
            title={video.title}
            allow="accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen>
          </iframe>
        </div>
        <a class="yt-link" href={watchUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a>

        {desc && (
          <article class="info-block">
            <h2>About this video</h2>
            <p>{desc}</p>
          </article>
        )}

        <h2 class="section-title">Browse Sports</h2>
        <div class="pill-list">
          {SPORTS.map((s) => (
            <a href={`/sports/${s.slug}`}>{s.emoji} {s.name}</a>
          ))}
        </div>
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>
