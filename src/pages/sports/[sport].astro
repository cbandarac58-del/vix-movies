                  <a href={`/sports/watch/${v.id}`} class="vid-card">
                    <div class="thumb-box">
                      <img src={v.thumb} alt={v.title} loading="lazy" decoding="async" width="480" height="270" />
                      <span class="play-icon">LIVE</span>
                    </div>
                    <h3 class="vid-title">{v.title}</h3>
                    <p class="vid-meta">{v.channelTitle}</p>
                  </a>
                ))}
              </div>
            )}
          </section>
        )}

        {upcoming.length > 0 && (
          <section>
            <h2 class="section-title">🗓️ Upcoming Streams</h2>
            <div class="vid-grid">
              {upcoming.slice(0, 8).map((v) => (
                <a href={`/sports/watch/${v.id}`} class="vid-card">
                  <div class="thumb-box">
                    <img src={v.thumb} alt={v.title} loading="lazy" decoding="async" width="480" height="270" />
                    <span class="play-icon">SOON</span>
                  </div>
                  <h3 class="vid-title">{v.title}</h3>
                  <p class="vid-meta">{v.channelTitle}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <section>
          <h2 class="section-title">▶️ Latest {sport.name} Highlights</h2>
          {highlights.length > 0 ? (
            <div class="vid-grid">
              {highlights.map((v) => (
                <a href={`/sports/watch/${v.id}`} class="vid-card" title={v.title}>
                  <div class="thumb-box">
                    <img src={v.thumb} alt={v.title} loading="lazy" decoding="async" width="480" height="270" />
                    <span class="play-icon">▶ Play</span>
                  </div>
                  <h3 class="vid-title">{v.title}</h3>
                  <p class="vid-meta">{v.channelTitle} • {fmtDate(v.published)}</p>
                </a>
              ))}
            </div>
          ) : loadFailed ? (
            <p class="empty">Videos are temporarily unavailable. Please try again in a few minutes.</p>
          ) : (
            <p class="empty">New {sport.name.toLowerCase()} videos will appear here soon.</p>
          )}
        </section>

        <section>
          <h2 class="section-title">More Sports</h2>
          <div class="pill-list">
            {SPORTS.map((s) => (
              <a href={`/sports/${s.slug}`} class={s.slug === sport.slug ? 'current' : ''}>
                {s.emoji} {s.name}
              </a>
            ))}
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
      </footer>
    </div>

    <script is:inline>
      // Click-to-load: the YouTube player loads only when the visitor taps the thumbnail
      document.querySelectorAll('.yt-facade').forEach((el) => {
        let done = false;
        const load = () => {
          if (done) return;
          done = true;
          const f = document.createElement('iframe');
          f.className = 'player-iframe';
          // Inline style: page styles do not reach elements created by JavaScript
          f.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;';
          f.setAttribute('frameborder', '0');
          f.src = el.dataset.embed;
          f.title = el.dataset.title || 'Video player';
          f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
          f.allowFullscreen = true;
          el.replaceChildren(f);
          el.classList.remove('yt-facade');
          el.removeAttribute('role');
          el.removeAttribute('tabindex');
        };
        el.addEventListener('click', load);
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            load();
          }
        });
      });
    </script>
  </body>
</html>
