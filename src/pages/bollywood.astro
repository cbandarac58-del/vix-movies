---
import Navbar from '../components/Navbar.astro';

const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Hindi (Bollywood) Movies from TMDB
const res = await fetch(`https://api.themoviedb.org/3/discover/movie?api_key=${TMDB_KEY}&with_original_language=hi&sort_by=popularity.desc`);
const data = await res.json();
const bollywoodMovies = data.results || [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bollywood Movies - Vix Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .page-title {
        font-size: 20px;
        font-weight: 800;
        margin: 20px 0 15px 0;
        color: #38bdf8;
      }
      .grid-movies {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
      @media (min-width: 640px) {
        .grid-movies { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
      @media (min-width: 900px) {
        .grid-movies { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }
      .movie-card {
        text-decoration: none;
        color: white;
      }
      .poster-box {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 2/3;
        background: #1e293b;
        border: 1px solid #334155;
      }
      .poster-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .badge-hd {
        position: absolute;
        top: 6px;
        left: 6px;
        background: #0284c7;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .badge-rating {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(15, 23, 42, 0.85);
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .card-title {
        font-size: 13px;
        margin: 6px 0 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar activePage="bollywood" />

      <h1 class="page-title">🍿 Bollywood Movies</h1>

      <div class="grid-movies">
        {bollywoodMovies.map((m) => (
          <a href={`/movie/${m.id}`} class="movie-card">
            <div class="poster-box">
              <img src={m.poster_path ? `https://image.tmdb.org/t/p/w500${m.poster_path}` : 'https://via.placeholder.com/500x750'} alt={m.title} loading="lazy" />
              <span class="badge-hd">HD</span>
              <span class="badge-rating">⭐ {m.vote_average ? m.vote_average.toFixed(1) : 'N/A'}</span>
            </div>
            <h3 class="card-title">{m.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </body>
</html>
