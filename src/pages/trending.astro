---
import Navbar from '../components/Navbar.astro';

const TMDB_KEY = import.meta.env.TMDB_API_KEY;
const SITE_URL = 'https://movies.vixtube.net';

// Fetch trending movies + TV this week
const res = await fetch(`https://api.themoviedb.org/3/trending/all/week?api_key=${TMDB_KEY}`);
const data = await res.json();

// Keep only movies and TV shows (skip people), with a poster, no adult titles
const items = (data.results || []).filter(
  (i) =>
    (i.media_type === 'movie' || i.media_type === 'tv') &&
    i.poster_path &&
    !i.adult
);

const topNames = items.slice(0, 3).map((i) => i.title || i.name);
const pageUrl = `${SITE_URL}/trending`;
const pageTitle = 'Trending Movies & TV Series This Week | Vix Movies';
const pageDescription = `See the most popular movies and TV series trending this week.${
  topNames.length ? ` Top picks: ${topNames.join(', ')}.` : ''
}`.slice(0, 158);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": "Trending This Week",
      "description": pageDescription
    },
    {
      "@type": "ItemList",
      "itemListElement": items.slice(0, 20).map((i, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "url": `${SITE_URL}/${i.media_type}/${i.id}`,
        "name": i.title || i.name
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
        { "@type": "ListItem", "position": 2, "name": "Trending", "item": pageUrl }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style>
      * { box-sizing: border-box; }
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .page-title {
        font-size: 20px;
        font-weight: 800;
        margin: 20px 0 8px 0;
        color: #38bdf8;
      }
      .intro {
        color: #cbd5e1;
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 18px 0;
      }
      .grid-movies {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
      @media (min-width: 640px) {
        .grid-movies { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
      @media (min-width: 900px) {
        .grid-movies { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }
      .movie-card {
        text-decoration: none;
        color: white;
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow: hidden;
      }
      .poster-box {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 2/3;
        background: #1e293b;
        border: 1px solid #334155;
      }
      .poster-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .badge-hd {
        position: absolute;
        top: 6px;
        left: 6px;
        background: #0284c7;
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .badge-type {
        position: absolute;
        bottom: 6px;
        left: 6px;
        background: rgba(15, 23, 42, 0.85);
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .badge-rating {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(15, 23, 42, 0.85);
        font-size: 10px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
      }
      .card-title {
        font-size: 13px;
        margin: 6px 0 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Footer */
      .site-footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #334155;
        text-align: center;
      }
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 12px;
      }
      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 13px;
      }
      .copyright-text {
        color: #64748b;
        font-size: 12px;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <main>
        <h1 class="page-title">🔥 Trending This Week</h1>
        <p class="intro">
          The {items.length} most popular movies and TV series this week.
          {topNames.length > 0 && ` Right now the top titles include ${topNames.join(', ')}.`}
          Open any title to see its rating, cast, trailer and full details.
        </p>

        <section class="grid-movies" aria-label="Trending movies and TV series">
          {items.map((item) => (
            <a
              href={`/${item.media_type}/${item.id}`}
              class="movie-card"
              title={`Watch ${item.title || item.name} online`}
            >
              <div class="poster-box">
                <img
                  src={`https://image.tmdb.org/t/p/w500${item.poster_path}`}
                  onerror="this.onerror=null;this.src='/no-poster.svg'"
                  alt={`${item.title || item.name} Poster`}
                  loading="lazy"
                  decoding="async"
                  width="500"
                  height="750"
                />
                <span class="badge-hd">HD</span>
                <span class="badge-rating">⭐ {item.vote_average ? item.vote_average.toFixed(1) : 'N/A'}</span>
                <span class="badge-type">{item.media_type === 'tv' ? 'TV' : 'Movie'}</span>
              </div>
              <h2 class="card-title">{item.title || item.name}</h2>
            </a>
          ))}
        </section>
      </main>

      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>
