---
import Navbar from '../components/Navbar.astro';
import Ads from '../components/Ads.astro';

const query = (Astro.url.searchParams.get('q') || '').trim().slice(0, 100);
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

let results = [];

if (query) {
  try {
    // Search movies and TV shows (multi), then drop people and adult titles
    const res = await fetch(
      `https://api.themoviedb.org/3/search/multi?api_key=${TMDB_KEY}&query=${encodeURIComponent(query)}&include_adult=false`
    );
    const data = await res.json();

    results = (data.results || []).filter(
      (i) =>
        (i.media_type === 'movie' || i.media_type === 'tv') &&
        !i.adult
    );
  } catch {
    results = [];
  }
}

const pageTitle = query
  ? `Search Results for "${query}" | Vix Movies`
  : 'Search Movies & TV Series | Vix Movies';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <!-- Search result pages should not be indexed -->
    <meta
      name="robots"
      content="noindex, follow"
    />

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family:
          'Segoe UI',
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
      }

      .search-title {
        font-size: 22px;
        font-weight: 700;
        margin: 20px 0;
        color: #cbd5e1;
      }

      .grid-container {
        display: grid;
        grid-template-columns:
          repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
      }

      .movie-card {
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #334155;
        text-decoration: none;
        color: white;
        transition:
          transform 0.2s,
          border-color 0.2s;
        display: flex;
        flex-direction: column;
      }

      .movie-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
      }

      .poster-img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        display: block;
        background-color: #0f172a;
      }

      .card-info {
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .card-title {
        font-size: 13px;
        font-weight: 600;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .card-badge {
        font-size: 11px;
        color: #38bdf8;
        font-weight: 600;
      }

      .no-results {
        color: #64748b;
        font-size: 15px;
        margin-top: 30px;
      }

      /* Ads */

      .search-ad {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .top-ad {
        margin: 4px 0 22px;
      }

      .native-ad {
        margin: 28px 0;
      }

      .square-ad {
        margin: 30px 0;
      }

      /* Footer */

      .site-footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #334155;
        text-align: center;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 12px;
      }

      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 13px;
      }

      .copyright-text {
        color: #64748b;
        font-size: 12px;
        margin: 0;
      }

      @media (max-width: 500px) {
        .grid-container {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
          gap: 12px;
        }

        .footer-links {
          gap: 14px;
          flex-wrap: wrap;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">

      <Navbar />

      <main>

        <h1 class="search-title">
          {query
            ? `Search Results for "${query}"`
            : 'Please enter a search query'}
        </h1>

        <!-- 320x50 Top Ad -->
        <div class="search-ad top-ad">
          <Ads type="top" />
        </div>

        {results.length > 0 ? (
          <>
            <div class="grid-container">
              {results.map((item, index) => {
                const title =
                  item.title || item.name;

                const date =
                  item.release_date ||
                  item.first_air_date;

                const year =
                  date
                    ? date.split('-')[0]
                    : 'N/A';

                return (
                  <>
                    <a
                      href={`/${item.media_type}/${item.id}`}
                      class="movie-card"
                    >
                      <img
                        src={
                          item.poster_path
                            ? `https://image.tmdb.org/t/p/w500${item.poster_path}`
                            : '/no-poster.svg'
                        }
                        onerror="this.onerror=null;this.src='/no-poster.svg'"
                        alt={`${title} Poster`}
                        class="poster-img"
                        loading="lazy"
                        decoding="async"
                        width="500"
                        height="750"
                      />

                      <div class="card-info">
                        <h2 class="card-title">
                          {title}
                        </h2>

                        <span class="card-badge">
                          {item.media_type === 'tv'
                            ? 'TV Series'
                            : 'Movie'}
                          {' • '}
                          {year}
                        </span>
                      </div>
                    </a>

                    {index === 7 && (
                      <div class="search-ad native-ad">
                        <Ads type="native" />
                      </div>
                    )}

                    {index === 15 && (
                      <div class="search-ad square-ad">
                        <Ads type="square" />
                      </div>
                    )}
                  </>
                );
              })}
            </div>
          </>
        ) : (
          query && (
            <p class="no-results">
              No movies or TV series found matching
              "{query}". Try searching for another name.
            </p>
          )
        )}

      </main>

      <footer class="site-footer">

        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>

        <p class="copyright-text">
          &copy; {new Date().getFullYear()}
          Vix Movies. All rights reserved.
        </p>

      </footer>

    </div>
  </body>
</html>
