---
import Navbar from '../components/Navbar.astro';

const query = Astro.url.searchParams.get('q') || '';
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

let movies = [];

if (query) {
  // Direct Search for Movies only (Excludes Person profiles)
  const res = await fetch(
    `https://api.themoviedb.org/3/search/movie?api_key=${TMDB_KEY}&query=${encodeURIComponent(query)}`
  );
  const data = await res.json();
  movies = data.results || [];
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Search Results for "{query}" - Vix Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .search-title {
        font-size: 22px;
        font-weight: 700;
        margin: 20px 0;
        color: #cbd5e1;
      }
      .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
      }
      .movie-card {
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #334155;
        text-decoration: none;
        color: white;
        transition: transform 0.2s, border-color 0.2s;
        display: flex;
        flex-direction: column;
      }
      .movie-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
      }
      .poster-img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
        background-color: #0f172a;
      }
      .card-info {
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .card-title {
        font-size: 13px;
        font-weight: 600;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .card-badge {
        font-size: 11px;
        color: #38bdf8;
        font-weight: 600;
      }
      .no-results {
        color: #64748b;
        font-size: 15px;
        margin-top: 30px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <h1 class="search-title">
        {query ? `Search Results for "${query}"` : 'Please enter a search query'}
      </h1>

      {movies.length > 0 ? (
        <div class="grid-container">
          {movies.map((movie) => (
            <a href={`/movie/${movie.id}`} class="movie-card">
              <img 
                src={movie.poster_path ? `https://image.tmdb.org/t/p/w500${movie.poster_path}` : 'https://via.placeholder.com/500x750/0f172a/cbd5e1?text=No+Poster'} 
                alt={movie.title} 
                class="poster-img"
              />
              <div class="card-info">
                <h2 class="card-title">{movie.title}</h2>
                <span class="card-badge">Movie • {movie.release_date ? movie.release_date.split('-')[0] : 'N/A'}</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        query && <p class="no-results">No movies found matching "{query}". Try searching for another movie name.</p>
      )}
    </div>
  </body>
</html>
