---
import Navbar from '../../components/Navbar.astro';

const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch Popular / Trending TV Shows
const res = await fetch(`https://api.themoviedb.org/3/trending/tv/week?api_key=${TMDB_KEY}`);
const data = await res.json();
const tvShows = data.results || [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stream Free TV Series & Web Series HD - Vix Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      .page-title {
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .tv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 20px;
      }
      .tv-card {
        background: #1e293b;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #334155;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        position: relative;
        text-decoration: none;
        color: white;
        display: block;
      }
      .tv-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.4);
        border-color: #38bdf8;
      }
      .poster-img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
      }
      .badge-hd {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(2, 132, 199, 0.9);
        color: white;
        font-size: 10px;
        font-weight: bold;
        padding: 3px 6px;
        border-radius: 4px;
      }
      .badge-rating {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(15, 23, 42, 0.85);
        color: #facc15;
        font-size: 11px;
        font-weight: bold;
        padding: 3px 6px;
        border-radius: 4px;
      }
      .card-info {
        padding: 10px;
      }
      .card-title {
        font-size: 13px;
        font-weight: 600;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <h1 class="page-title">📺 Trending TV & Web Series</h1>

      <div class="tv-grid">
        {tvShows.map((show) => (
          <a href={`/tv/${show.id}`} class="tv-card">
            <span class="badge-hd">TV</span>
            <span class="badge-rating">⭐ {show.vote_average ? show.vote_average.toFixed(1) : 'N/A'}</span>
            <img 
              class="poster-img" 
              src={show.poster_path ? `https://image.tmdb.org/t/p/w500${show.poster_path}` : 'https://via.placeholder.com/500x750?text=No+Poster'} 
              alt={show.name} 
              loading="lazy"
            />
            <div class="card-info">
              <h3 class="card-title">{show.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </body>
</html>
