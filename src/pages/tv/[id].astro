---
import Navbar from '../../components/Navbar.astro';

const { id } = Astro.params;
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

const slugify = (t = '') =>
  t.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// Fetch TV Show Details (+ cast, trailer, streaming availability)
const res = await fetch(
  `https://api.themoviedb.org/3/tv/${id}?api_key=${TMDB_KEY}&append_to_response=credits,videos,watch/providers`
);
const show = await res.json();
if (!show.id) {
  return new Response('Not found', { status: 404 });
}

// Fetch Similar Shows (only ones that have a poster)
const simRes = await fetch(`https://api.themoviedb.org/3/tv/${id}/similar?api_key=${TMDB_KEY}`);
const simData = await simRes.json();
const similarShows = (simData.results || []).filter((s) => s.poster_path).slice(0, 6);

const seasons = show.seasons ? show.seasons.filter((s) => s.season_number > 0) : [];

// Basic data
const SITE_URL = 'https://movies.vixtube.net';
const showName = show.name || 'TV Series';
const firstYear = show.first_air_date ? show.first_air_date.split('-')[0] : '';
const titleYear = `${showName}${firstYear ? ` (${firstYear})` : ''}`;
const castAll = show.credits?.cast || [];
const cast = castAll.slice(0, 6);
const castRoles = castAll.slice(0, 10);
const creatorObjs = show.created_by || [];
const creators = creatorObjs.map((c) => c.name);
const networks = (show.networks || []).slice(0, 3).map((n) => n.name);
const trailer = (show.videos?.results || []).find(
  (v) => v.site === 'YouTube' && v.type === 'Trailer'
);
const genres = show.genres || [];
const genreNames = genres.map((g) => g.name);
const genreText = genreNames.join(', ').toLowerCase() || 'drama';
const article = /^[aeiou]/.test(genreText) ? 'an' : 'a';
const seasonCount = show.number_of_seasons;
const episodeCount = show.number_of_episodes;
const episodeRuntime = show.episode_run_time?.[0];

// Helpers
const fmtDate = (d) =>
  d
    ? new Date(d).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : '';
const firstAirText = fmtDate(show.first_air_date);
const lastAirText = fmtDate(show.last_air_date);
const nextEpisodeText = fmtDate(show.next_episode_to_air?.air_date);

// Streaming availability (data by JustWatch via TMDB)
const COUNTRIES = {
  US: 'United States',
  GB: 'United Kingdom',
  IN: 'India',
  CA: 'Canada',
  AU: 'Australia',
  LK: 'Sri Lanka',
};
const provData = show['watch/providers']?.results || {};
const names = (arr) => (arr || []).map((x) => x.provider_name).slice(0, 6).join(', ');
const providerRows = Object.entries(COUNTRIES)
  .map(([code, name]) => {
    const p = provData[code];
    if (!p) return null;
    const stream = names(p.flatrate);
    const rent = names(p.rent);
    const buy = names(p.buy);
    if (!stream && !rent && !buy) return null;
    return { code, name, stream, rent, buy };
  })
  .filter(Boolean);

// Summary paragraph (built from real data)
const summary = `${titleYear} is ${article} ${genreText} TV series${
  seasonCount
    ? ` with ${seasonCount} season${seasonCount > 1 ? 's' : ''}${episodeCount ? ` and ${episodeCount} episodes` : ''}`
    : ''
}${creators.length ? `, created by ${creators.join(', ')}` : ''}${
  cast.length ? `, starring ${cast.slice(0, 3).map((c) => c.name).join(', ')}` : ''
}. It holds a ${show.vote_average ? show.vote_average.toFixed(1) : 'N/A'}/10 rating on TMDB${
  show.vote_count ? ` from ${show.vote_count} votes` : ''
}.`;

// FAQ (every answer comes from real data, and is shown on the page)
const faqs = [];
if (creators.length) {
  faqs.push({ q: `Who created ${showName}?`, a: `${showName} was created by ${creators.join(', ')}.` });
}
if (castRoles.length) {
  const list = castRoles
    .slice(0, 5)
    .map((c) => (c.character ? `${c.name} (as ${c.character})` : c.name))
    .join(', ');
  faqs.push({ q: `Who stars in ${showName}?`, a: `The main cast of ${showName} includes ${list}.` });
}
if (seasonCount) {
  faqs.push({
    q: `How many seasons and episodes does ${showName} have?`,
    a: `${showName} has ${seasonCount} season${seasonCount > 1 ? 's' : ''}${
      episodeCount ? ` and ${episodeCount} episodes in total` : ''
    }.`,
  });
}
if (episodeRuntime) {
  faqs.push({ q: `How long is each episode of ${showName}?`, a: `Episodes of ${showName} run about ${episodeRuntime} minutes.` });
}
if (firstAirText) {
  faqs.push({ q: `When did ${showName} first air?`, a: `${showName} first aired on ${firstAirText}.` });
}
if (show.status) {
  const ended = ['Ended', 'Canceled'].includes(show.status);
  faqs.push({
    q: `Is ${showName} still running?`,
    a: ended
      ? `No. ${showName} has ${show.status === 'Canceled' ? 'been canceled' : 'ended'}${lastAirText ? `, and its last episode aired on ${lastAirText}` : ''}.`
      : `Yes, ${showName} is listed as "${show.status}"${nextEpisodeText ? `, and the next episode is scheduled for ${nextEpisodeText}` : ''}.`,
  });
}
if (networks.length) {
  faqs.push({ q: `Which network aired ${showName}?`, a: `${showName} aired on ${networks.join(', ')}.` });
}
if (genreNames.length) {
  faqs.push({ q: `What genre is ${showName}?`, a: `${showName} is ${article} ${genreText} TV series.` });
}
if (show.vote_count > 0 && show.vote_average) {
  faqs.push({
    q: `What is the rating of ${showName}?`,
    a: `${showName} has a rating of ${show.vote_average.toFixed(1)}/10 on TMDB, based on ${show.vote_count} votes.`,
  });
}
if (providerRows.length) {
  const parts = providerRows.map((r) => {
    const bits = [];
    if (r.stream) bits.push(`streaming on ${r.stream}`);
    if (r.rent) bits.push(`rent on ${r.rent}`);
    if (r.buy) bits.push(`buy on ${r.buy}`);
    return `${r.name}: ${bits.join('; ')}`;
  });
  faqs.push({
    q: `Where can I watch ${showName} legally?`,
    a: `According to JustWatch data provided by TMDB, ${showName} is available in these places. ${parts.join('. ')}.`,
  });
}

// Thin pages (no overview or almost no votes) should not be indexed
const isThin = !show.overview || (show.vote_count || 0) < 5;
const robotsContent = isThin
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const pageTitle = `${titleYear} - Cast, Trailer & Episodes | Vix Movies`;
const pageDescription = summary.length > 158 ? summary.slice(0, 155) + '...' : summary;
const posterUrl = show.poster_path ? `https://image.tmdb.org/t/p/w500${show.poster_path}` : `${SITE_URL}/no-poster.svg`;
const backdropUrl = show.backdrop_path ? `https://image.tmdb.org/t/p/w1280${show.backdrop_path}` : posterUrl;
// Smaller image for the click-to-load player thumbnail
const facadeUrl = show.backdrop_path ? `https://image.tmdb.org/t/p/w780${show.backdrop_path}` : posterUrl;
const pageUrl = `${SITE_URL}/tv/${id}`;

// Breadcrumb: Home > TV Series > (first genre) > show
const firstGenre = genres[0];
const crumbs = [
  { name: 'Home', item: SITE_URL },
  { name: 'TV Series', item: `${SITE_URL}/tv` },
  ...(firstGenre
    ? [{ name: `${firstGenre.name} TV Series`, item: `${SITE_URL}/tv/genre/${slugify(firstGenre.name)}` }]
    : []),
  { name: showName, item: pageUrl },
];
const breadcrumb = crumbs.map((c, i) => ({
  "@type": "ListItem",
  "position": i + 1,
  "name": c.name,
  "item": c.item,
}));

// Schema.org Structured Data
const schemaGraph = [
  {
    "@type": "TVSeries",
    "@id": pageUrl,
    "url": pageUrl,
    "name": showName,
    "image": posterUrl,
    "description": show.overview || pageDescription,
    "datePublished": show.first_air_date || firstYear,
    "numberOfSeasons": seasonCount,
    "numberOfEpisodes": episodeCount,
    "genre": genreNames,
    "creator": creatorObjs.length
      ? creatorObjs.map((c) => ({ "@type": "Person", "name": c.name, "url": `${SITE_URL}/person/${c.id}` }))
      : undefined,
    "actor": cast.map((c) => ({ "@type": "Person", "name": c.name, "url": `${SITE_URL}/person/${c.id}` }))
  },
  { "@type": "BreadcrumbList", "itemListElement": breadcrumb },
];
if (faqs.length) {
  schemaGraph.push({
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  });
}
const tvSchema = { "@context": "https://schema.org", "@graph": schemaGraph };
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Vix Movies" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="video.tv_show" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={backdropUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={backdropUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(tvSchema)} />

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .header {
        margin-top: 15px;
        margin-bottom: 15px;
      }
      .title {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 5px 0;
      }
      .meta {
        color: #94a3b8;
        font-size: 14px;
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
      }
      .meta a {
        color: inherit;
        text-decoration: underline;
      }
      .control-bar {
        background: #1e293b;
        padding: 12px;
        border-radius: 8px;
        margin: 15px 0;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        border: 1px solid #334155;
        align-items: center;
      }
      .select-box {
        background: #0f172a;
        color: white;
        border: 1px solid #334155;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
        cursor: pointer;
      }
      .player-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #334155;
        background: #000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .player-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Click-to-load player thumbnail */
      .facade {
        cursor: pointer;
      }
      .facade-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.7);
      }
      .facade-play {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 72px;
        height: 72px;
        background: rgba(2, 132, 199, 0.95);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: #fff;
        padding-left: 4px;
      }
      .facade-label {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 14px;
        text-align: center;
        font-size: 13px;
        font-weight: 700;
        color: #e2e8f0;
      }

      .server-btn {
        background: #0f172a;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
      }
      .server-btn.active {
        background: #0284c7;
        color: white;
        border-color: #0284c7;
      }

      /* Action Bar (Like & Share) */
      .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #1e293b;
        padding: 12px 16px;
        border-radius: 8px;
        margin-top: 15px;
        border: 1px solid #334155;
        flex-wrap: wrap;
        gap: 12px;
      }
      .vote-container, .share-container {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .share-title {
        font-size: 13px;
        color: #94a3b8;
        font-weight: 600;
      }
      .vote-btn {
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid #334155;
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s;
      }
      .vote-btn:hover {
        background: #334155;
      }
      .vote-btn.active-like {
        background: #22c55e;
        border-color: #22c55e;
        color: white;
      }
      .vote-btn.active-dislike {
        background: #ef4444;
        border-color: #ef4444;
        color: white;
      }
      .share-btn {
        border: none;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.2s;
      }
      .share-btn:hover {
        opacity: 0.85;
      }
      .share-btn.wa { background: #25D366; }
      .share-btn.fb { background: #1877F2; }
      .share-btn.tg { background: #229ED9; }
      .share-btn.copy { background: #475569; }

      /* Show Information Block */
      .info-block {
        margin-top: 25px;
        background: #1e293b;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #334155;
      }
      .info-block h2 {
        font-size: 18px;
        color: #38bdf8;
        margin-top: 0;
      }
      .info-block h2:not(:first-child) {
        margin-top: 24px;
      }
      .info-block p {
        color: #cbd5e1;
        line-height: 1.6;
        font-size: 14px;
      }
      .details-list, .cast-list, .provider-list, .season-list {
        color: #cbd5e1;
        font-size: 14px;
        line-height: 1.8;
        padding-left: 18px;
        margin: 0;
      }
      .details-list a, .cast-list a {
        color: #38bdf8;
        text-decoration: none;
      }
      .details-list a:hover, .cast-list a:hover {
        text-decoration: underline;
      }
      .faq-item h3 {
        font-size: 15px;
        color: #f8fafc;
        margin: 14px 0 4px 0;
      }
      .faq-item p {
        margin: 0;
      }
      .attribution {
        font-size: 11px;
        color: #64748b;
        margin-top: 8px;
      }
      .ad-slot {
        margin: 24px 0;
        text-align: center;
        min-height: 90px;
      }

      /* Native Comment Section Styling */
      .comments-section {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #334155;
      }
      .comment-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 25px;
        background: #1e293b;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid #334155;
      }
      .comment-input, .comment-textarea {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        padding: 10px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
      }
      .comment-input:focus, .comment-textarea:focus {
        border-color: #38bdf8;
      }
      .comment-submit-btn {
        background: #0284c7;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        align-self: flex-start;
      }
      .comment-submit-btn:hover {
        background: #0369a1;
      }
      .comments-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
      }
      .comment-card {
        background: #1e293b;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #334155;
      }
      .comment-author {
        font-weight: 700;
        font-size: 14px;
        color: #38bdf8;
      }
      .comment-date {
        font-size: 11px;
        color: #64748b;
        margin-left: 8px;
      }
      .comment-text {
        font-size: 13px;
        color: #cbd5e1;
        margin-top: 6px;
        line-height: 1.4;
      }

      .grid-recommendations {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 15px;
      }
      .rec-card {
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #334155;
        text-decoration: none;
        color: white;
        transition: transform 0.2s;
      }
      .rec-card:hover {
        transform: translateY(-4px);
        border-color: #38bdf8;
      }

      /* Site Footer */
      .site-footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #334155;
        text-align: center;
      }
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 12px;
      }
      .footer-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
      }
      .footer-links a:hover {
        color: #38bdf8;
      }
      .copyright-text {
        color: #64748b;
        font-size: 12px;
        margin: 0 0 8px 0;
      }
      .tmdb-note {
        color: #64748b;
        font-size: 11px;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <main>
        <header class="header">
          <h1 class="title">{titleYear}</h1>
          <div class="meta">
            <span>⭐ {show.vote_average ? show.vote_average.toFixed(1) : 'N/A'} / 10</span>
            {seasonCount && <span>📺 {seasonCount} Season{seasonCount > 1 ? 's' : ''}</span>}
            <span style="color: #38bdf8; font-weight: bold;">TV Series</span>
            {genres.length > 0 && (
              <span>
                🎭{' '}
                {genres.map((g, i) => (
                  <>
                    <a href={`/tv/genre/${slugify(g.name)}`}>{g.name}</a>{i < genres.length - 1 ? ', ' : ''}
                  </>
                ))}
              </span>
            )}
          </div>
        </header>

        <!-- Season & Episode Selectors -->
        <div class="control-bar">
          <div>
            <label style="font-size: 13px; color: #94a3b8; font-weight: 600; margin-right: 5px;">Season:</label>
            <select id="season-select" class="select-box">
              {seasons.map((s) => (
                <option value={s.season_number}>Season {s.season_number} ({s.episode_count} Episodes)</option>
              ))}
            </select>
          </div>

          <div>
            <label style="font-size: 13px; color: #94a3b8; font-weight: 600; margin-right: 5px;">Episode:</label>
            <select id="episode-select" class="select-box">
              <!-- Dynamically Populated -->
            </select>
          </div>

          <!-- Server 2 (VidSrc) is the default -->
          <div style="margin-left: auto; display: flex; gap: 8px;">
            <button class="server-btn" data-server="autoembed">Server 1</button>
            <button class="server-btn active" data-server="vidsrc">Server 2</button>
          </div>
        </div>

        <!-- Click-to-load player: the player loads only after the visitor clicks -->
        <div
          id="player-box"
          class="player-container facade"
          role="button"
          tabindex="0"
          aria-label={`Play ${showName}`}>
          <img class="facade-img" src={facadeUrl} alt={`Watch ${showName}`} width="780" height="439" decoding="async" fetchpriority="high" />
          <span class="facade-play">▶</span>
          <span class="facade-label">Click to play</span>
        </div>

        <!-- Action Bar (Like & Share) -->
        <div class="action-bar">
          <div class="vote-container">
            <button id="like-btn" class="vote-btn" aria-label="Like series">
              👍 <span id="like-count">0</span>
            </button>
            <button id="dislike-btn" class="vote-btn" aria-label="Dislike series">
              👎 <span id="dislike-count">0</span>
            </button>
          </div>

          <div class="share-container">
            <span class="share-title">Share:</span>
            <button id="share-wa" class="share-btn wa">WhatsApp</button>
            <button id="share-fb" class="share-btn fb">Facebook</button>
            <button id="share-tg" class="share-btn tg">Telegram</button>
            <button id="copy-link" class="share-btn copy">📋 Copy Link</button>
          </div>
        </div>

        <!-- Overview, Details, Seasons, Cast, Where to Watch, FAQ & Trailer -->
        <article class="info-block">
          <h2>Overview</h2>
          <p>{show.overview || 'No overview available for this title.'}</p>
          <p>{summary}</p>

          <h2>Details</h2>
          <ul class="details-list">
            {show.tagline && <li><b>Tagline:</b> {show.tagline}</li>}
            {show.original_name && show.original_name !== show.name && (
              <li><b>Original title:</b> {show.original_name}</li>
            )}
            {firstAirText && <li><b>First air date:</b> {firstAirText}</li>}
            {lastAirText && <li><b>Last air date:</b> {lastAirText}</li>}
            {nextEpisodeText && <li><b>Next episode:</b> {nextEpisodeText}</li>}
            {show.status && <li><b>Status:</b> {show.status}</li>}
            {show.type && <li><b>Type:</b> {show.type}</li>}
            {seasonCount && <li><b>Seasons:</b> {seasonCount}{episodeCount ? ` (${episodeCount} episodes)` : ''}</li>}
            {episodeRuntime && <li><b>Episode runtime:</b> about {episodeRuntime} minutes</li>}
            {creatorObjs.length > 0 && (
              <li>
                <b>Created by:</b>{' '}
                {creatorObjs.map((c, i) => (
                  <>
                    <a href={`/person/${c.id}`}>{c.name}</a>{i < creatorObjs.length - 1 ? ', ' : ''}
                  </>
                ))}
              </li>
            )}
            {networks.length > 0 && <li><b>Network:</b> {networks.join(', ')}</li>}
            {show.production_companies?.length > 0 && (
              <li><b>Production:</b> {show.production_companies.slice(0, 3).map((c) => c.name).join(', ')}</li>
            )}
            {show.origin_country?.length > 0 && <li><b>Country:</b> {show.origin_country.join(', ')}</li>}
            {show.spoken_languages?.length > 0 && (
              <li><b>Languages:</b> {show.spoken_languages.map((l) => l.english_name).join(', ')}</li>
            )}
          </ul>

          {seasons.length > 0 && (
            <>
              <h2>Seasons & Episodes</h2>
              <ul class="season-list">
                {seasons.map((s) => (
                  <li>
                    <b>{s.name || `Season ${s.season_number}`}:</b> {s.episode_count} episode{s.episode_count === 1 ? '' : 's'}
                    {s.air_date ? `, first aired ${fmtDate(s.air_date)}` : ''}
                  </li>
                ))}
              </ul>
            </>
          )}

          <!-- Ad slot: Native Banner (Adsterra) -->
          <div class="ad-slot">
            <script async data-cfasync="false" src="https://toleranceteaminadequate.com/e9a7ebb5b4ccad1a0f4057850ab50885/invoke.js"></script>
            <div id="container-e9a7ebb5b4ccad1a0f4057850ab50885"></div>
          </div>

          {castRoles.length > 0 && (
            <>
              <h2>Cast & Characters</h2>
              <ul class="cast-list">
                {castRoles.map((c) => (
                  <li>
                    <a href={`/person/${c.id}`}><b>{c.name}</b></a>{c.character ? ` as ${c.character}` : ''}
                  </li>
                ))}
              </ul>
            </>
          )}

          {providerRows.length > 0 && (
            <>
              <h2>Where to Watch {showName} Legally</h2>
              <ul class="provider-list">
                {providerRows.map((r) => (
                  <li>
                    <b>{r.name}:</b>
                    {r.stream && ` Stream on ${r.stream}.`}
                    {r.rent && ` Rent on ${r.rent}.`}
                    {r.buy && ` Buy on ${r.buy}.`}
                  </li>
                ))}
              </ul>
              <p class="attribution">Streaming availability data provided by JustWatch via TMDB.</p>
            </>
          )}

          {faqs.length > 0 && (
            <>
              <h2>Frequently Asked Questions about {showName}</h2>
              {faqs.map((f) => (
                <div class="faq-item">
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </div>
              ))}
            </>
          )}

          {trailer && (
            <>
              <h2>Trailer</h2>
              <div class="player-container">
                <iframe
                  class="player-iframe"
                  src={`https://www.youtube.com/embed/${trailer.key}`}
                  title={`${showName} trailer`}
                  loading="lazy"
                  allowfullscreen>
                </iframe>
              </div>
            </>
          )}
        </article>

        <!-- Native Comment Section -->
        <section class="comments-section">
          <h2 style="font-size: 18px; margin-bottom: 15px;">💬 Leave a Comment</h2>

          <form id="comment-form" class="comment-form">
            <input type="text" id="author-name" class="comment-input" placeholder="Your Name" required />
            <textarea id="comment-msg" class="comment-textarea" rows="3" placeholder="Write your comment here..." required></textarea>
            <button type="submit" class="comment-submit-btn">Post Comment</button>
          </form>

          <div id="comments-list" class="comments-list">
            <!-- Comments will appear here -->
          </div>
        </section>

        <!-- Similar Shows -->
        {similarShows.length > 0 && (
          <section style="margin-top: 35px;" aria-label="Recommended Series">
            <h2 style="font-size: 18px; margin-bottom: 15px;">You May Also Like</h2>
            <div class="grid-recommendations">
              {similarShows.map((sim) => (
                <a href={`/tv/${sim.id}`} class="rec-card" title={`Watch ${sim.name}`}>
                  <img src={`https://image.tmdb.org/t/p/w500${sim.poster_path}`} onerror="this.onerror=null;this.src='/no-poster.svg'" alt={`${sim.name} Poster`} style="width: 100%; height: auto; aspect-ratio: 2/3; object-fit: cover; display: block;" loading="lazy" decoding="async" width="500" height="750" />
                  <div style="padding: 8px;">
                    <h3 style="font-size: 12px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{sim.name}</h3>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </main>

      <!-- Footer -->
      <footer class="site-footer">
        <div class="footer-links">
          <a href="/about">About Us</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </div>
        <p class="copyright-text">&copy; {new Date().getFullYear()} Vix Movies. All rights reserved.</p>
        <p class="tmdb-note">This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
      </footer>
    </div>

    <script is:inline define:vars={{ tmdbId: id, seasonsData: seasons, showName: showName }}>
      document.addEventListener('DOMContentLoaded', () => {
        const seasonSelect = document.getElementById('season-select');
        const episodeSelect = document.getElementById('episode-select');
        const box = document.getElementById('player-box');
        const serverBtns = document.querySelectorAll('.server-btn');
        let currentServer = 'vidsrc';
        let iframe = null;

        function srcFor() {
          const s = seasonSelect.value || 1;
          const e = episodeSelect.value || 1;
          if (currentServer === 'vidsrc') {
            return `https://vidsrc.me/embed/tv?tmdb=${tmdbId}&season=${s}&episode=${e}`;
          }
          return `https://autoembed.co/tv/tmdb/${tmdbId}-${s}-${e}`;
        }

        // Click-to-load: create the player on the first click, later just update its source
        function loadPlayer() {
          const src = srcFor();
          if (!iframe) {
            iframe = document.createElement('iframe');
            // Inline style: page styles do not reach elements created by JavaScript
            iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:0;';
            iframe.setAttribute('frameborder', '0');
            iframe.title = 'Watch ' + showName;
            iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
            iframe.allowFullscreen = true;
            iframe.src = src;
            box.replaceChildren(iframe);
            box.classList.remove('facade');
            box.removeAttribute('role');
            box.removeAttribute('tabindex');
            box.removeAttribute('aria-label');
          } else if (iframe.getAttribute('src') !== src) {
            iframe.src = src;
          }
        }

        // When season/episode changes, only update the player if it is already loaded
        function refreshPlayer() {
          if (iframe) loadPlayer();
        }

        function updateEpisodes() {
          const selectedSeasonNum = parseInt(seasonSelect.value);
          const seasonObj = seasonsData.find(s => s.season_number === selectedSeasonNum);
          const epCount = seasonObj ? seasonObj.episode_count : 20;

          episodeSelect.innerHTML = '';
          for (let i = 1; i <= epCount; i++) {
            const opt = document.createElement('option');
            opt.value = i;
            opt.innerText = `Episode ${i}`;
            episodeSelect.appendChild(opt);
          }
          refreshPlayer();
        }

        box.addEventListener('click', loadPlayer);
        box.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            loadPlayer();
          }
        });

        seasonSelect.addEventListener('change', updateEpisodes);
        episodeSelect.addEventListener('change', refreshPlayer);

        serverBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            serverBtns.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            currentServer = e.target.getAttribute('data-server');
            loadPlayer();
          });
        });

        // Like / Dislike Logic
        const likeKey = `vix_like_tv_${tmdbId}`;
        const dislikeKey = `vix_dislike_tv_${tmdbId}`;
        const userVoteKey = `vix_uservote_tv_${tmdbId}`;

        const likeBtn = document.getElementById('like-btn');
        const dislikeBtn = document.getElementById('dislike-btn');
        const likeCountEl = document.getElementById('like-count');
        const dislikeCountEl = document.getElementById('dislike-count');

        let likes = parseInt(localStorage.getItem(likeKey) || '0');
        let dislikes = parseInt(localStorage.getItem(dislikeKey) || '0');
        let userVote = localStorage.getItem(userVoteKey);

        function renderVotes() {
          likeCountEl.innerText = likes;
          dislikeCountEl.innerText = dislikes;

          likeBtn.classList.remove('active-like');
          dislikeBtn.classList.remove('active-dislike');

          if (userVote === 'like') likeBtn.classList.add('active-like');
          if (userVote === 'dislike') dislikeBtn.classList.add('active-dislike');
        }

        likeBtn.addEventListener('click', () => {
          if (userVote === 'like') {
            likes--;
            userVote = null;
          } else {
            if (userVote === 'dislike') dislikes--;
            likes++;
            userVote = 'like';
          }
          localStorage.setItem(likeKey, likes);
          localStorage.setItem(dislikeKey, dislikes);
          if (userVote) localStorage.setItem(userVoteKey, userVote);
          else localStorage.removeItem(userVoteKey);
          renderVotes();
        });

        dislikeBtn.addEventListener('click', () => {
          if (userVote === 'dislike') {
            dislikes--;
            userVote = null;
          } else {
            if (userVote === 'like') likes--;
            dislikes++;
            userVote = 'dislike';
          }
          localStorage.setItem(likeKey, likes);
          localStorage.setItem(dislikeKey, dislikes);
          if (userVote) localStorage.setItem(userVoteKey, userVote);
          else localStorage.removeItem(userVoteKey);
          renderVotes();
        });

        renderVotes();

        // Social Share Logic
        const currentUrl = encodeURIComponent(window.location.href);
        const shareText = encodeURIComponent(`Watch TV Series "${showName || 'TV Series'}" for free in HD on Vix Movies!`);

        document.getElementById('share-wa').addEventListener('click', () => {
          window.open(`https://api.whatsapp.com/send?text=${shareText}%20${currentUrl}`, '_blank');
        });

        document.getElementById('share-fb').addEventListener('click', () => {
          window.open(`https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`, '_blank');
        });

        document.getElementById('share-tg').addEventListener('click', () => {
          window.open(`https://t.me/share/url?url=${currentUrl}&text=${shareText}`, '_blank');
        });

        document.getElementById('copy-link').addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard!');
        });

        // Local Storage / Client-side Comment Handling
        const commentForm = document.getElementById('comment-form');
        const commentsList = document.getElementById('comments-list');
        const storageKey = `comments_tv_${tmdbId}`;

        function loadComments() {
          const comments = JSON.parse(localStorage.getItem(storageKey) || '[]');
          commentsList.innerHTML = '';
          if (comments.length === 0) {
            commentsList.innerHTML = '<p style="color: #64748b; font-size: 13px;">No comments yet. Be the first to comment!</p>';
            return;
          }
          comments.forEach(c => {
            const div = document.createElement('div');
            div.className = 'comment-card';
            div.innerHTML = `
              <div>
                <span class="comment-author">${escapeHtml(c.name)}</span>
                <span class="comment-date">${c.date}</span>
              </div>
              <div class="comment-text">${escapeHtml(c.message)}</div>
            `;
            commentsList.appendChild(div);
          });
        }

        commentForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const nameInput = document.getElementById('author-name');
          const msgInput = document.getElementById('comment-msg');

          const newComment = {
            name: nameInput.value.trim() || 'Anonymous User',
            message: msgInput.value.trim(),
            date: new Date().toLocaleDateString()
          };

          const comments = JSON.parse(localStorage.getItem(storageKey) || '[]');
          comments.unshift(newComment);
          localStorage.setItem(storageKey, JSON.stringify(comments));

          msgInput.value = '';
          loadComments();
        });

        function escapeHtml(text) {
          return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        // Initial Loads (the player itself loads only after a click)
        updateEpisodes();
        loadComments();
      });
    </script>
  </body>
</html>
