---
import Navbar from '../../components/Navbar.astro';

const { id } = Astro.params;
const TMDB_KEY = import.meta.env.TMDB_API_KEY;

// Fetch TV Show Details
const res = await fetch(`https://api.themoviedb.org/3/tv/${id}?api_key=${TMDB_KEY}`);
const show = await res.json();

const seasons = show.seasons ? show.seasons.filter((s) => s.season_number > 0) : [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Watch {show.name || 'TV Series'} Free HD - Vix Movies</title>
    <style>
      body {
        background-color: #0b0f19;
        color: #f8fafc;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0 15px 40px 15px;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .header {
        margin-top: 15px;
        margin-bottom: 15px;
      }
      .title {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 5px 0;
      }
      .meta {
        color: #94a3b8;
        font-size: 14px;
        display: flex;
        gap: 15px;
        align-items: center;
      }
      .control-bar {
        background: #1e293b;
        padding: 12px;
        border-radius: 8px;
        margin: 15px 0;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        border: 1px solid #334155;
        align-items: center;
      }
      .select-box {
        background: #0f172a;
        color: white;
        border: 1px solid #334155;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
        cursor: pointer;
      }
      .player-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #334155;
        background: #000;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      }
      .player-iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .server-btn {
        background: #0f172a;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
      }
      .server-btn.active {
        background: #0284c7;
        color: white;
        border-color: #0284c7;
      }

      /* Native Comment Section Styling */
      .comments-section {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #334155;
      }
      .comment-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 25px;
        background: #1e293b;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid #334155;
      }
      .comment-input, .comment-textarea {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        padding: 10px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
      }
      .comment-input:focus, .comment-textarea:focus {
        border-color: #38bdf8;
      }
      .comment-submit-btn {
        background: #0284c7;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        align-self: flex-start;
      }
      .comment-submit-btn:hover {
        background: #0369a1;
      }
      .comments-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
      }
      .comment-card {
        background: #1e293b;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #334155;
      }
      .comment-author {
        font-weight: 700;
        font-size: 14px;
        color: #38bdf8;
      }
      .comment-date {
        font-size: 11px;
        color: #64748b;
        margin-left: 8px;
      }
      .comment-text {
        font-size: 13px;
        color: #cbd5e1;
        margin-top: 6px;
        line-height: 1.4;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Navbar />

      <div class="header">
        <h1 class="title">{show.name}</h1>
        <div class="meta">
          <span>⭐ {show.vote_average ? show.vote_average.toFixed(1) : 'N/A'} / 10</span>
          <span>📅 {show.first_air_date ? show.first_air_date.split('-')[0] : ''}</span>
          <span style="color: #38bdf8; font-weight: bold;">TV Series</span>
        </div>
      </div>

      <!-- Season & Episode Selectors -->
      <div class="control-bar">
        <div>
          <label style="font-size: 13px; color: #94a3b8; font-weight: 600; margin-right: 5px;">Season:</label>
          <select id="season-select" class="select-box">
            {seasons.map((s) => (
              <option value={s.season_number}>Season {s.season_number} ({s.episode_count} Episodes)</option>
            ))}
          </select>
        </div>

        <div>
          <label style="font-size: 13px; color: #94a3b8; font-weight: 600; margin-right: 5px;">Episode:</label>
          <select id="episode-select" class="select-box">
            <!-- Dynamically Populated -->
          </select>
        </div>

        <div style="margin-left: auto; display: flex; gap: 8px;">
          <button class="server-btn active" data-server="autoembed">Server 1</button>
          <button class="server-btn" data-server="vidsrc">Server 2</button>
        </div>
      </div>

      <!-- Video Player Frame -->
      <div class="player-container">
        <iframe 
          id="tv-player"
          class="player-iframe"
          src={`https://autoembed.co/tv/tmdb/${id}-1-1`} 
          allowfullscreen>
        </iframe>
      </div>

      <!-- Overview -->
      <div style="margin-top: 25px;">
        <h2 style="font-size: 18px;">Overview</h2>
        <p style="color: #cbd5e1; line-height: 1.6; font-size: 14px;">{show.overview}</p>
      </div>

      <!-- Native Comment Section -->
      <div class="comments-section">
        <h2 style="font-size: 18px; margin-bottom: 15px;">💬 Leave a Comment</h2>
        
        <form id="comment-form" class="comment-form">
          <input type="text" id="author-name" class="comment-input" placeholder="Your Name" required />
          <textarea id="comment-msg" class="comment-textarea" rows="3" placeholder="Write your comment here..." required></textarea>
          <button type="submit" class="comment-submit-btn">Post Comment</button>
        </form>

        <div id="comments-list" class="comments-list">
          <!-- Comments will appear here -->
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ tmdbId: id, seasonsData: seasons }}>
      document.addEventListener('DOMContentLoaded', () => {
        const seasonSelect = document.getElementById('season-select');
        const episodeSelect = document.getElementById('episode-select');
        const player = document.getElementById('tv-player');
        const serverBtns = document.querySelectorAll('.server-btn');
        let currentServer = 'autoembed';

        function updateEpisodes() {
          const selectedSeasonNum = parseInt(seasonSelect.value);
          const seasonObj = seasonsData.find(s => s.season_number === selectedSeasonNum);
          const epCount = seasonObj ? seasonObj.episode_count : 20;

          episodeSelect.innerHTML = '';
          for (let i = 1; i <= epCount; i++) {
            const opt = document.createElement('option');
            opt.value = i;
            opt.innerText = `Episode ${i}`;
            episodeSelect.appendChild(opt);
          }
          loadVideo();
        }

        function loadVideo() {
          const s = seasonSelect.value || 1;
          const e = episodeSelect.value || 1;

          if (currentServer === 'vidsrc') {
            player.src = `https://vidsrc.me/embed/tv?tmdb=${tmdbId}&season=${s}&episode=${e}`;
          } else {
            player.src = `https://autoembed.co/tv/tmdb/${tmdbId}-${s}-${e}`;
          }
        }

        seasonSelect.addEventListener('change', updateEpisodes);
        episodeSelect.addEventListener('change', loadVideo);

        serverBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            serverBtns.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            currentServer = e.target.getAttribute('data-server');
            loadVideo();
          });
        });

        // Local Storage / Client-side Comment Handling
        const commentForm = document.getElementById('comment-form');
        const commentsList = document.getElementById('comments-list');
        const storageKey = `comments_tv_${tmdbId}`;

        function loadComments() {
          const comments = JSON.parse(localStorage.getItem(storageKey) || '[]');
          commentsList.innerHTML = '';
          if (comments.length === 0) {
            commentsList.innerHTML = '<p style="color: #64748b; font-size: 13px;">No comments yet. Be the first to comment!</p>';
            return;
          }
          comments.forEach(c => {
            const div = document.createElement('div');
            div.className = 'comment-card';
            div.innerHTML = `
              <div>
                <span class="comment-author">${c.name}</span>
                <span class="comment-date">${c.date}</span>
              </div>
              <div class="comment-text">${c.message}</div>
            `;
            commentsList.appendChild(div);
          });
        }

        commentForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const nameInput = document.getElementById('author-name');
          const msgInput = document.getElementById('comment-msg');

          const newComment = {
            name: nameInput.value.trim(),
            message: msgInput.value.trim(),
            date: new Date().toLocaleDateString()
          };

          const comments = JSON.parse(localStorage.getItem(storageKey) || '[]');
          comments.unshift(newComment);
          localStorage.setItem(storageKey, JSON.stringify(comments));

          msgInput.value = '';
          loadComments();
        });

        // Initial Loads
        updateEpisodes();
        loadComments();
      });
    </script>
  </body>
</html>
