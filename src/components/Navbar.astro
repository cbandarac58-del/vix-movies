---
const { activePage } = Astro.props;

const path = Astro.url.pathname;

const detect = () => {

  if (path === '/') return 'home';

  if (path.startsWith('/hollywood'))
    return 'hollywood';

  if (path.startsWith('/bollywood'))
    return 'bollywood';

  if (path.startsWith('/tv'))
    return 'tv';

  if (path.startsWith('/trending'))
    return 'trending';

  if (path.startsWith('/sports'))
    return 'sports';

  if (
    path.startsWith('/movie') ||
    path.startsWith('/genre')
  ) {
    return 'home';
  }

  return '';
};

const current = activePage || detect();

const items = [
  {
    key: 'home',
    href: '/',
    label: 'Home',
    icon: '🏠'
  },
  {
    key: 'hollywood',
    href: '/hollywood',
    label: 'Hollywood',
    icon: '🎬'
  },
  {
    key: 'bollywood',
    href: '/bollywood',
    label: 'Bollywood',
    icon: '🍿'
  },
  {
    key: 'tv',
    href: '/tv',
    label: 'TV Series',
    icon: '📺'
  },
  {
    key: 'trending',
    href: '/trending',
    label: 'Trending',
    icon: '🔥'
  },
  {
    key: 'sports',
    href: '/sports',
    label: 'Sports',
    icon: '🏆'
  }
];
---

<header class="navbar-container">

  <div class="nav-top">

    <a
      href="/"
      class="logo"
      aria-label="Vix Movies Home"
    >
      <span class="blue">VIX</span> MOVIES
    </a>

    <details
      class="menu"
      id="site-menu"
    >

      <summary
        class="menu-btn"
        aria-label="Open menu"
      >

        <span class="bars">
          ☰
        </span>

        <span>
          Menu
        </span>

      </summary>

      <nav
        class="menu-panel"
        aria-label="Main menu"
      >

        {items.map((i) => (

          <a
            href={i.href}
            class={
              current === i.key
                ? 'menu-item active'
                : 'menu-item'
            }
          >

            <span class="menu-icon">
              {i.icon}
            </span>

            {i.label}

          </a>

        ))}

      </nav>

    </details>

  </div>

  <form
    action="/search"
    method="GET"
    class="search-bar"
  >

    <input
      type="text"
      name="q"
      class="search-input"
      placeholder="Search movies, TV shows..."
      required
      aria-label="Search movies and TV shows"
    />

    <button
      type="submit"
      class="search-btn"
      aria-label="Search"
    >
      🔍
    </button>

  </form>

  <nav
    class="nav-links"
    aria-label="Main navigation"
  >

    {items.map((i) => (

      <a
        href={i.href}
        class={
          current === i.key
            ? 'nav-item active'
            : 'nav-item'
        }
      >
        {i.label}
      </a>

    ))}

  </nav>

</header>

<script>

  document.addEventListener(
    'click',
    (e) => {

      const menu =
        document.getElementById(
          'site-menu'
        );

      if (
        menu &&
        menu.hasAttribute('open') &&
        !menu.contains(
          e.target as Node
        )
      ) {

        menu.removeAttribute('open');

      }

    }
  );

</script>

<style>

  .navbar-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 15px 0 10px 0;
  }

  .nav-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 22px;
    font-weight: 900;
    color: white;
    text-decoration: none;
    letter-spacing: 0.5px;
  }

  .blue {
    color: #38bdf8;
  }

  .menu {
    position: relative;
  }

  .menu-btn {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
    background: #1e293b;
    border: 1px solid #334155;
    color: #f8fafc;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    user-select: none;
  }

  .menu-btn::-webkit-details-marker {
    display: none;
  }

  .menu[open] .menu-btn {
    border-color: #38bdf8;
    color: #38bdf8;
  }

  .bars {
    font-size: 16px;
    line-height: 1;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 210px;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 6px;
    z-index: 100;
    box-shadow:
      0 12px 30px
      rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    padding: 11px 12px;
    border-radius: 8px;
  }

  .menu-item:hover {
    background: #0f172a;
    color: #f8fafc;
  }

  .menu-item.active {
    background:
      rgba(56, 189, 248, 0.12);
    color: #38bdf8;
  }

  .menu-icon {
    width: 22px;
    text-align: center;
  }

  .search-bar {
    display: flex;
    gap: 8px;
    width: 100%;
  }

  .search-input {
    flex: 1;
    background: #1e293b;
    border: 1px solid #334155;
    color: white;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
  }

  .search-input:focus {
    border-color: #38bdf8;
  }

  .search-btn {
    background: #0284c7;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
  }

  .search-btn:hover {
    background: #0369a1;
  }

  .nav-links {
    display: none;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .nav-item {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .nav-item:hover {
    color: #f8fafc;
  }

  .nav-item.active {
    color: #38bdf8;
    border-bottom:
      2px solid #38bdf8;
    padding-bottom: 2px;
  }

  @media (min-width: 700px) {

    .menu {
      display: none;
    }

    .nav-links {
      display: flex;
    }

  }

</style>
