---
const { activePage = 'home' } = Astro.props;
---

<nav class="nav-bar">
  <div class="brand">
    <a href="/" class="logo"><span class="blue">VIX</span> MOVIES</a>
  </div>
  <div class="nav-links">
    <a href="/" class={activePage === 'home' ? 'nav-item active' : 'nav-item'}>Home</a>
    <a href="/hollywood" class={activePage === 'hollywood' ? 'nav-item active' : 'nav-item'}>Hollywood</a>
    <a href="/bollywood" class={activePage === 'bollywood' ? 'nav-item active' : 'nav-item'}>Bollywood</a>
    <a href="/tv" class={activePage === 'tv' ? 'nav-item active' : 'nav-item'}>TV Series</a>
  </div>
</nav>

<style>
  .nav-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 15px 0;
  }
  .logo {
    font-size: 22px;
    font-weight: 900;
    color: white;
    text-decoration: none;
    letter-spacing: 0.5px;
  }
  .blue {
    color: #38bdf8;
  }
  .nav-links {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .nav-item {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .nav-item:hover {
    color: #f8fafc;
  }
  .nav-item.active {
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
    padding-bottom: 2px;
  }
</style>
