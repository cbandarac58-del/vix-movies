---
const { activePage } = Astro.props;

const path = Astro.url.pathname;

const detect = () => {
  if (path === '/') return 'home';
  if (path.startsWith('/hollywood')) return 'hollywood';
  if (path.startsWith('/bollywood')) return 'bollywood';
  if (path.startsWith('/tv')) return 'tv';
  if (path.startsWith('/trending')) return 'trending';
  if (path.startsWith('/sports')) return 'sports';

  if (
    path.startsWith('/movie') ||
    path.startsWith('/genre')
  ) {
    return 'home';
  }

  return '';
};

const current = activePage || detect();

const items = [
  {
    key: 'home',
    href: '/',
    label: 'Home',
    icon: '\u{1F3E0}'
  },
  {
    key: 'hollywood',
    href: '/hollywood',
    label: 'Hollywood',
    icon: '\u{1F3AC}'
  },
  {
    key: 'bollywood',
    href: '/bollywood',
    label: 'Bollywood',
    icon: '\u{1F37F}'
  },
  {
    key: 'tv',
    href: '/tv',
    label: 'TV Series',
    icon: '\u{1F4FA}'
  },
  {
    key: 'trending',
    href: '/trending',
    label: 'Trending',
    icon: '\u{1F525}'
  },
  {
    key: 'sports',
    href: '/sports',
    label: 'Sports',
    icon: '\u{1F3C6}'
  }
];
---

<header class="navbar-container">

  <div class="nav-top">

    <a
      href="/"
      class="logo"
      aria-label="Vix Movies Home"
    >
      <span class="blue">VIX</span> MOVIES
    </a>

    <details
      class="menu"
      id="site-menu"
    >

      <summary
        class="menu-btn"
        aria-label="Open menu"
      >
        <span class="bars">&#9776;</span>
        <span>Menu</span>
      </summary>

      <nav
        class="menu-panel"
        aria-label="Main menu"
      >

        {items.map((i) => (
          <a
            href={i.href}
            class={
              current === i.key
                ? 'menu-item active'
                : 'menu-item'
            }
          >
            <span class="menu-icon">
              {i.icon}
            </span>

            {i.label}
          </a>
        ))}

      </nav>

    </details>

  </div>

  <form
    action="/search"
    method="GET"
    class="search-bar"
  >

    <input
      type="text"
      name="q"
      class="search-input"
      placeholder="Search movies, TV shows..."
      required
      aria-label="Search movies and TV shows"
    />

    <button
      type="submit"
      class="search-btn"
      aria-label="Search"
    >
      &#128269;
    </button>

  </form>

  <a
    href="https://toleranceteaminadequate.com/v6w61gm8x9?key=b5eb71c1d48725723eadb761d48e201b"
    target="_blank"
    rel="noopener noreferrer"
    class="download-cta-btn"
    title="Download Movie in HD"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    <span>Download Movie</span>
  </a>

  <nav
    class="nav-links"
    aria-label="Main navigation"
  >

    {items.map((i) => (
      <a
        href={i.href}
        class={
          current === i.key
            ? 'nav-item active'
            : 'nav-item'
        }
      >
        {i.label}
      </a>
    ))}

  </nav>

</header>

<script>

  document.addEventListener(
    'click',
    (e) => {

      const menu =
        document.getElementById(
          'site-menu'
        );

      if (
        menu &&
        menu.hasAttribute('open') &&
        !menu.contains(e.target as Node)
      ) {

        menu.removeAttribute('open');

      }

      const dlBtn = (e.target as HTMLElement)?.closest?.('.download-cta-btn');
      if (dlBtn) {
        setTimeout(() => {
          if (typeof (window as any).__vixTriggerDownload === 'function') {
            (window as any).__vixTriggerDownload(true);
          } else {
            window.location.href = 'https://t.me/free_movies_stream_bot';
          }
        }, 800);
      }

    }
  );

</script>

<style>

  .navbar-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 15px 0 10px 0;
  }

  .nav-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 22px;
    font-weight: 900;
    color: white;
    text-decoration: none;
    letter-spacing: 0.5px;
  }

  .blue {
    color: #38bdf8;
  }

  .menu {
    position: relative;
  }

  .menu-btn {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
    background: #1e293b;
    border: 1px solid #334155;
    color: #f8fafc;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    user-select: none;
  }

  .menu-btn::-webkit-details-marker {
    display: none;
  }

  .menu[open] .menu-btn {
    border-color: #38bdf8;
    color: #38bdf8;
  }

  .bars {
    font-size: 16px;
    line-height: 1;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 210px;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 6px;
    z-index: 100;
    box-shadow:
      0 12px 30px
      rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    padding: 11px 12px;
    border-radius: 8px;
  }

  .menu-item:hover {
    background: #0f172a;
    color: #f8fafc;
  }

  .menu-item.active {
    background:
      rgba(56, 189, 248, 0.12);
    color: #38bdf8;
  }

  .menu-icon {
    width: 22px;
    text-align: center;
  }

  .search-bar {
    display: flex;
    gap: 8px;
    width: 100%;
  }

  .search-input {
    flex: 1;
    background: #1e293b;
    border: 1px solid #334155;
    color: white;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
  }

  .search-input:focus {
    border-color: #38bdf8;
  }

  .search-btn {
    background: #0284c7;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
  }

  .search-btn:hover {
    background: #0369a1;
  }

  .nav-links {
    display: none;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .nav-item {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .nav-item:hover {
    color: #f8fafc;
  }

  .nav-item.active {
    color: #38bdf8;
    border-bottom:
      2px solid #38bdf8;
    padding-bottom: 2px;
  }

  @media (min-width: 700px) {

    .menu {
      display: none;
    }

    .nav-links {
      display: flex;
    }

  }

  .download-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    border: 1px solid rgba(16, 185, 129, 0.45);
    border-radius: 8px;
    padding: 10px 18px;
    text-decoration: none;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
    width: 100%;
  }

  .download-cta-btn:hover {
    background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
  }

</style>
