---
const { activePage = 'home' } = Astro.props;
---

<header class="navbar-container">
  <div class="nav-top">
    <a href="/" class="logo"><span class="blue">VIX</span> MOVIES</a>
  </div>

  <!-- Search Bar for All Pages -->
  <form action="/search" method="GET" class="search-bar">
    <input type="text" name="q" class="search-input" placeholder="Search movies, TV shows..." required />
    <button type="submit" class="search-btn">🔍</button>
  </form>

  <nav class="nav-links">
    <a href="/" class={activePage === 'home' ? 'nav-item active' : 'nav-item'}>Home</a>
    <a href="/hollywood" class={activePage === 'hollywood' ? 'nav-item active' : 'nav-item'}>Hollywood</a>
    <a href="/bollywood" class={activePage === 'bollywood' ? 'nav-item active' : 'nav-item'}>Bollywood</a>
    <a href="/tv" class={activePage === 'tv' ? 'nav-item active' : 'nav-item'}>TV Series</a>
  </nav>
</header>

<style>
  .navbar-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 15px 0 10px 0;
  }
  .nav-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 22px;
    font-weight: 900;
    color: white;
    text-decoration: none;
    letter-spacing: 0.5px;
  }
  .blue {
    color: #38bdf8;
  }
  
  /* Global Search Bar */
  .search-bar {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .search-input {
    flex: 1;
    background: #1e293b;
    border: 1px solid #334155;
    color: white;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
  }
  .search-btn {
    background: #0284c7;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
  }

  .nav-links {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .nav-item {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .nav-item:hover {
    color: #f8fafc;
  }
  .nav-item.active {
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
    padding-bottom: 2px;
  }
</style>
