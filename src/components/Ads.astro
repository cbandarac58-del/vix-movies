---
---

<div class="global-ads">

  <!-- =========================
       TOP 320x50 BANNER
       ========================= -->

  <div class="ad-slot top-banner-ad">
    <div
      id="global-ad-top-320"
      class="ad-host ad-host-320"
    ></div>
  </div>


  <!-- =========================
       NATIVE BANNER
       ========================= -->

  <div class="ad-slot native-ad">
    <div
      id="global-ad-native"
      class="ad-host ad-host-native"
    ></div>
  </div>


  <!-- =========================
       300x250 BANNER
       ========================= -->

  <div class="ad-slot ad-300x250">
    <div
      id="global-ad-300"
      class="ad-host ad-host-300"
    ></div>
  </div>

</div>


<script is:inline>
  function loadGlobalNativeAd(hostId, containerId, key) {
    return new Promise((resolve) => {
      const host = document.getElementById(hostId);

      if (!host) {
        resolve();
        return;
      }

      const container = document.createElement('div');
      container.id = containerId;
      host.appendChild(container);

      const script = document.createElement('script');

      script.async = true;
      script.setAttribute('data-cfasync', 'false');
      script.src =
        `https://toleranceteaminadequate.com/${key}/invoke.js`;

      script.onload = resolve;
      script.onerror = resolve;

      host.appendChild(script);
    });
  }


  function loadGlobalBannerAd(hostId, key, width, height) {
    return new Promise((resolve) => {
      const host = document.getElementById(hostId);

      if (!host) {
        resolve();
        return;
      }

      window.atOptions = {
        key: key,
        format: 'iframe',
        height: height,
        width: width,
        params: {}
      };

      const script = document.createElement('script');

      script.type = 'text/javascript';
      script.src =
        `https://toleranceteaminadequate.com/${key}/invoke.js`;

      script.async = false;

      script.onload = resolve;
      script.onerror = resolve;

      host.appendChild(script);
    });
  }


  async function loadGlobalAds() {

    /* 320x50 */
    await loadGlobalBannerAd(
      'global-ad-top-320',
      '09d84e44afaa5e3c051baecc7e938408',
      320,
      50
    );


    /* Native */
    await loadGlobalNativeAd(
      'global-ad-native',
      'container-e9a7ebb5b4ccad1a0f4057850ab50885',
      'e9a7ebb5b4ccad1a0f4057850ab50885'
    );


    /* 300x250 */
    await loadGlobalBannerAd(
      'global-ad-300',
      '2800610326ebafc17c30013f7a1096e5',
      300,
      250
    );

  }


  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      loadGlobalAds
    );
  } else {
    loadGlobalAds();
  }
</script>


<style>
  .global-ads {
    width: 100%;
  }

  .ad-slot {
    width: 100%;
    margin: 20px 0;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }

  .top-banner-ad {
    min-height: 50px;
    margin: 8px 0 14px 0;
  }

  .native-ad {
    min-height: 90px;
  }

  .ad-300x250 {
    min-height: 250px;
  }

  .ad-host {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }

  .ad-host-320 {
    width: 320px;
    min-height: 50px;
    max-width: 100%;
  }

  .ad-host-native {
    width: 100%;
    min-height: 90px;
  }

  .ad-host-300 {
    width: 300px;
    min-height: 250px;
    max-width: 100%;
  }

  @media (max-width: 340px) {
    .ad-host-320 {
      transform: scale(0.95);
      transform-origin: center;
    }
  }
</style>
