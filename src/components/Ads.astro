---
const { type = 'top' } = Astro.props;

const configs = {
  top: {
    hostId: 'vix-ad-320',
    key: '09d84e44afaa5e3c051baecc7e938408',
    width: 320,
    height: 50,
    className: 'ad-320x50'
  },

  native: {
    hostId: 'vix-ad-native',
    containerId:
      'container-e9a7ebb5b4ccad1a0f4057850ab50885',
    key: 'e9a7ebb5b4ccad1a0f4057850ab50885',
    className: 'ad-native'
  },

  square: {
    hostId: 'vix-ad-300',
    key: '2800610326ebafc17c30013f7a1096e5',
    width: 300,
    height: 250,
    className: 'ad-300x250'
  }
};

const config = configs[type];
---

{config && (
  <div class={`vix-ad-slot ${config.className}`}>
    <div
      id={config.hostId}
      class="vix-ad-host"
    ></div>
  </div>
)}

{config && type === 'top' && (
  <script
    is:inline
    define:vars={{
      hostId: config.hostId,
      key: config.key,
      width: config.width,
      height: config.height
    }}
  >
    (() => {

      window.__vixBannerQueue =
        window.__vixBannerQueue ||
        Promise.resolve();

      window.__vixBannerQueue =
        window.__vixBannerQueue.then(() => {

          return new Promise((resolve) => {

            const host =
              document.getElementById(hostId);

            if (!host) {
              resolve();
              return;
            }

            if (
              host.dataset.loaded === 'true'
            ) {
              resolve();
              return;
            }

            host.dataset.loaded = 'true';

            window.atOptions = {
              key: key,
              format: 'iframe',
              height: height,
              width: width,
              params: {}
            };

            const script =
              document.createElement('script');

            script.type =
              'text/javascript';

            script.src =
              `https://toleranceteaminadequate.com/${key}/invoke.js`;

            script.async = false;

            script.onload = () => resolve();

            script.onerror = () => resolve();

            host.appendChild(script);

          });

        });

    })();
  </script>
)}

{config && type === 'native' && (
  <script
    is:inline
    define:vars={{
      hostId: config.hostId,
      containerId: config.containerId,
      key: config.key
    }}
  >
    (() => {

      const loadNative = () => {

        const host =
          document.getElementById(hostId);

        if (!host) return;

        if (
          host.dataset.loaded === 'true'
        ) {
          return;
        }

        host.dataset.loaded = 'true';

        const container =
          document.createElement('div');

        container.id = containerId;

        host.appendChild(container);

        const script =
          document.createElement('script');

        script.async = true;

        script.setAttribute(
          'data-cfasync',
          'false'
        );

        script.src =
          `https://toleranceteaminadequate.com/${key}/invoke.js`;

        host.appendChild(script);
      };

      if (
        document.readyState === 'loading'
      ) {

        document.addEventListener(
          'DOMContentLoaded',
          loadNative,
          { once: true }
        );

      } else {

        loadNative();

      }

    })();
  </script>
)}

{config && type === 'square' && (
  <script
    is:inline
    define:vars={{
      hostId: config.hostId,
      key: config.key,
      width: config.width,
      height: config.height
    }}
  >
    (() => {

      window.__vixBannerQueue =
        window.__vixBannerQueue ||
        Promise.resolve();

      window.__vixBannerQueue =
        window.__vixBannerQueue.then(() => {

          return new Promise((resolve) => {

            const host =
              document.getElementById(hostId);

            if (!host) {
              resolve();
              return;
            }

            if (
              host.dataset.loaded === 'true'
            ) {
              resolve();
              return;
            }

            host.dataset.loaded = 'true';

            window.atOptions = {
              key: key,
              format: 'iframe',
              height: height,
              width: width,
              params: {}
            };

            const script =
              document.createElement('script');

            script.type =
              'text/javascript';

            script.src =
              `https://toleranceteaminadequate.com/${key}/invoke.js`;

            script.async = false;

            script.onload = () => resolve();

            script.onerror = () => resolve();

            host.appendChild(script);

          });

        });

    })();
  </script>
)}

<style>

  .vix-ad-slot {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
    margin: 20px 0;
  }

  .ad-320x50 {
    min-height: 50px;
    margin: 14px 0 20px;
  }

  .ad-native {
    min-height: 90px;
    margin: 25px 0;
  }

  .ad-300x250 {
    min-height: 250px;
    margin: 28px 0;
  }

  .vix-ad-host {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }

  #vix-ad-320 {
    width: 320px;
    min-height: 50px;
    max-width: 100%;
  }

  #vix-ad-native {
    width: 100%;
    min-height: 90px;
  }

  #vix-ad-300 {
    width: 300px;
    min-height: 250px;
    max-width: 100%;
  }

  @media (max-width: 340px) {

    #vix-ad-320 {
      transform: scale(0.94);
      transform-origin: center;
    }

  }

</style>
