---
import Navbar from '../components/Navbar.astro';
import Ads from '../components/Ads.astro';

const {
  title = 'Vix Movies',
  description = 'Movies, TV Series and Entertainment'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <slot name="head" />
  </head>

  <body>

    <Navbar />

    <!-- GLOBAL ADS -->
    <Ads />

    <main>
      <slot />
    </main>

    <slot name="footer" />

  </body>
</html>
